---
import { ArrowDownRight } from 'lucide-astro';
---
<section class="hero" id="top">
  <img class="hero-image" src="/images/lovina-sunrise.png" alt="A traditional outrigger boat crossing the calm Lovina Sea at sunrise" fetchpriority="high" />
  <div class="wash"></div><div class="ocean-light"></div>
  <div class="hero-content wrap">
    <p class="eyebrow place">North Bali · 08°09' south</p>
    <h1 aria-label="Lovina"><span>L</span><span>O</span><span>V</span><span>I</span><span>N</span><span>A</span></h1>
    <div class="hero-bottom">
      <p>Slow mornings, open seas,<br />and the Bali that stays with you.</p>
      <a class="text-link" href="#experiences">Begin slowly <ArrowDownRight size={15} stroke-width={1.5} /></a>
    </div>
  </div>
</section>
<style>
  .hero{min-height:100svh;position:relative;overflow:hidden;background:var(--white)}.hero-image{position:absolute;inset:0;height:100%;object-fit:cover;object-position:center}.wash{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,255,255,.4),rgba(255,255,255,0) 42%,rgba(255,255,255,.2))}.ocean-light{position:absolute;width:55vw;height:55vw;border-radius:50%;background:rgba(74,175,192,.08);filter:blur(50px);animation:drift 20s ease-in-out infinite alternate}.hero-content{position:relative;min-height:100svh;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:clamp(2.5rem,5vw,5rem)}.place{position:absolute;top:8.5rem;right:0}.hero h1{display:flex;justify-content:space-between;font-family:var(--serif);font-weight:300;font-size:clamp(4.7rem,14.6vw,13rem);line-height:.72;letter-spacing:-.07em;margin:0;color:var(--white);text-shadow:0 2px 30px rgba(74,175,192,.15)}.hero h1 span{opacity:0;filter:blur(18px);transform:translateY(25px);animation:letter-in 1.5s cubic-bezier(.16,1,.3,1) forwards}.hero h1 span:nth-child(2){animation-delay:.05s}.hero h1 span:nth-child(3){animation-delay:.1s}.hero h1 span:nth-child(4){animation-delay:.15s}.hero h1 span:nth-child(5){animation-delay:.2s}.hero h1 span:nth-child(6){animation-delay:.25s}.hero-bottom{display:flex;justify-content:space-between;align-items:flex-end;margin-top:2rem;color:var(--white)}.hero-bottom p{font-family:var(--serif);font-size:clamp(1.25rem,2vw,1.7rem);font-style:italic;line-height:1.15;margin:0}.hero-bottom .text-link{font-family:var(--sans);font-style:normal}@keyframes letter-in{to{opacity:1;filter:blur(0);transform:none}}@keyframes drift{from{left:-15%;top:20%}to{left:65%;top:8%}}
  @media(max-width:767px){.hero-image{object-position:43% center}.place{top:7.5rem;right:auto}.hero h1{font-size:clamp(4.3rem,22vw,7rem);letter-spacing:-.08em}.hero-bottom{align-items:flex-start;gap:2.5rem;flex-direction:column}.hero-bottom p{font-size:1.35rem}}
</style>
