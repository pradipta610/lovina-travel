---
import { ArrowRight, Sun, Waves, Users } from 'lucide-astro';
---
<section class="featured" id="journey">
  <div class="feature-image reveal"><img src="/images/dolphin-journey.png" alt="A local outrigger boat sailing toward dolphins in the first morning light" loading="lazy" /><div class="image-note"><span class="eyebrow">06:12 AM</span><span class="eyebrow">Lovina Sea</span></div></div>
  <div class="feature-copy">
    <p class="eyebrow reveal">01 · Featured journey</p>
    <h2 class="display reveal">Dolphin<br /><em>sunrise.</em></h2>
    <p class="story reveal">Before the beach wakes, we leave shore in a traditional jukung. The sea is cool and still. The horizon shifts from pearl to gold—and somewhere ahead, a fin breaks the surface.</p>
    <div class="details reveal">
      <div><Sun size={19} stroke-width={1.3}/><span class="eyebrow">First light</span><p>Start before sunrise</p></div>
      <div><Waves size={19} stroke-width={1.3}/><span class="eyebrow">Calm sea</span><p>Traditional local boat</p></div>
      <div><Users size={19} stroke-width={1.3}/><span class="eyebrow">Personal</span><p>Private or small group</p></div>
    </div>
    <div class="price-row reveal"><span><small>Shared</small>€85</span><span><small>Private</small>€160</span><a class="btn" href="#contact">See the journey <ArrowRight size={15} /></a></div>
  </div>
</section>
<style>
  .featured{display:grid;grid-template-columns:1.06fr .94fr;min-height:930px}.feature-image{position:relative;min-height:800px}.feature-image img{height:100%;object-fit:cover}.image-note{position:absolute;inset:auto 2rem 2rem;display:flex;justify-content:space-between;color:var(--white)}.feature-copy{padding:clamp(4rem,8vw,9rem);display:flex;flex-direction:column;justify-content:center}.feature-copy h2{font-size:clamp(4.7rem,8vw,8.2rem);margin:2rem 0 2.5rem}.story{font-family:var(--serif);font-size:clamp(1.35rem,2vw,1.8rem);line-height:1.35;max-width:25em}.details{border-top:1px solid var(--sand);border-bottom:1px solid var(--sand);margin:3.5rem 0;display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;padding:1.6rem 0}.details>div{display:grid;gap:.7rem}.details p{font-size:.75rem;margin:0;line-height:1.5}.price-row{display:flex;align-items:flex-end;gap:2rem}.price-row>span{font-family:var(--serif);font-size:1.9rem}.price-row small{display:block;font-family:var(--sans);font-size:.58rem;letter-spacing:.15em;text-transform:uppercase;margin-bottom:.3rem}.price-row .btn{margin-left:auto}
  @media(max-width:950px){.featured{grid-template-columns:1fr;min-height:auto}.feature-image{min-height:72svh}.feature-copy{padding:6rem 1.25rem}.details{grid-template-columns:1fr;gap:1.5rem}.details>div{grid-template-columns:25px 1fr;align-items:center}.details p{grid-column:2}.price-row{flex-wrap:wrap}.price-row .btn{width:100%;margin:1rem 0 0}}
</style>
