---
import { Sparkles } from 'lucide-astro';
---
<section class="quote-section section-pad">
  <div class="quote-wrap wrap reveal">
    <Sparkles size={25} stroke-width={1.2} />
    <p class="display">When something good happens, come to Bali to <em>celebrate.</em></p>
    <div class="hairline"></div>
    <p class="display">When something hard happens, come to Bali to <em>exhale.</em></p>
    <div class="hairline"></div>
    <p class="display">When nothing happens, come to Bali and <em>begin.</em></p>
  </div>
</section>
<style>
  .quote-section{text-align:center}.quote-wrap{max-width:1060px}.quote-wrap>svg{margin:0 auto 3rem}.quote-wrap p{font-size:clamp(2.5rem,5vw,5.7rem);margin:2.7rem auto;line-height:1.02}.hairline{width:44px;margin:auto}
</style>
