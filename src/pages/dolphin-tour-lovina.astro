---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, ArrowUpRight, Clock3, MapPin, ShipWheel, Check, Menu } from 'lucide-astro';
import { business } from '../data/business';
const updated = '2026-11-01';
const title = 'Dolphin Tour Lovina | Private & Sharing Boats | Utami Mesari Tours';
const description = 'Plan your dolphin tour in Lovina with Bu Ayu. Compare private and sharing boats, check morning timings, and ask about prices and hotel pickup.';
const quote = (choice: string) => `https://wa.me/6281999966044?text=${encodeURIComponent(`Hello Bu Ayu, I would like to ask about ${choice} in Lovina. My date: ... Group size (adults/children): ... Hotel/pickup location: ...`)}`;
const faqs = [
  { q: 'How much does a dolphin tour in Lovina cost?', a: 'Contact Bu Ayu for a quote for your date, boat choice, and group size. Ask whether the quote is per person or per boat, what is included, and whether hotel pickup is charged separately. Confirm adult and child rates before payment.' },
  { q: 'What is the difference between a private and sharing boat?', a: 'On a sharing boat you join other guests. A private boat is reserved for your own group. Confirm the capacity, departure time, price basis, and inclusions with Ayu for either option.' },
  { q: 'What time does the tour start and finish?', a: 'Departure is usually around 06:00, with a return around 08:00–09:00 depending on the package. That is an approximate 2–3 hour morning window, not a fixed duration for every trip. Your exact meeting time is confirmed with your booking.' },
  { q: 'Can you pick us up from our hotel?', a: 'Hotel pickup is available at an extra charge depending on your location. Share your hotel name or location with Ayu to confirm availability, the pickup time, and the additional cost.' },
  { q: 'Where is the meeting point?', a: 'Your captain details, exact meeting point, and rundown are shared after payment. Do not use a general Lovina Beach map pin as your confirmed departure point.' },
  { q: 'Can children join, and how many people fit on a boat?', a: 'Tell Ayu the ages of any children and your full group size before booking. Confirm the age requirements, child pricing, suitable safety equipment, and capacity of the specific boat assigned to your trip.' },
  { q: 'Are snorkeling, food, or photos included?', a: 'Only the inclusions agreed for your selected package apply. Do not assume snorkeling, meals, drinks, or photography are included. Ask Ayu for the package breakdown before payment.' },
  { q: 'How do I book, and when will I receive the meeting point?', a: 'Contact Bu Ayu, choose your package, and agree on the price and payment arrangements. After payment, receive your captain details, exact meeting point, and rundown. Then attend the meeting point or take the pickup you have arranged.' },
  { q: 'Can you help with transport or hotel recommendations?', a: 'Yes. Ayu can help with transport, hotel and villa recommendations, and itinerary planning. Transport services cover Lovina, Singaraja, Negara, and Denpasar. Arrange any transport, accommodation, or extra sightseeing separately from your dolphin tour.' },
  { q: 'What happens if the weather changes or I need to cancel?', a: 'Ask Ayu to confirm the cancellation, weather, rescheduling, and refund terms before you pay. Do not assume the same terms apply to every situation.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: new URL('/dolphin-tour-lovina/', Astro.site).href, dateModified: updated, inLanguage: 'en', mainEntity: { '@type': 'Service', name: 'Dolphin Tour Lovina', serviceType: 'Dolphin watching tour', provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: { '@type': 'Place', name: 'Lovina, North Bali' } } };
---
<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  <header class="tour-header"><div class="shell tour-nav"><a class="tour-brand" href="/"><span>U</span><strong>Utami Mesari Tours<small>Lovina · North Bali</small></strong></a><nav aria-label="Tour navigation"><a href="#boats">Boat options</a><a href="#your-morning">Your morning</a><a href="#questions">Good to know</a><a href="/gallery#dolphins">Gallery</a></nav><a class="button nav-book" href={quote('a dolphin tour')}>Ask Bu Ayu <ArrowUpRight size={16}/></a><button class="tour-menu" aria-label="Open navigation" aria-expanded="false" aria-controls="tour-mobile"><Menu size={22}/></button></div><nav id="tour-mobile" class="tour-mobile" aria-label="Mobile tour navigation" hidden><a href="#boats">Boat options</a><a href="#your-morning">Your morning</a><a href="#questions">Good to know</a><a href="/">Back to home</a></nav></header>
  <main>
    <section class="tour-hero" id="top"><img class="hero-photo" src="/images/lovina-dolphins-hero.webp" alt="Dolphins surfacing on the Lovina Sea at sunrise" fetchpriority="high"/><div class="hero-overlay"></div><div class="shell hero-content"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Dolphin tour Lovina</span></nav><p class="eyebrow">An early start. A different side of Bali.</p><h1>Dolphin tour <br/><span>Lovina.</span></h1><p class="hero-intro">A morning on the sea, arranged with Bu Ayu.<br/>Choose a private or sharing boat, and let’s plan the details together.</p><div class="hero-actions"><a class="button light" href="#boats">Find your boat <ArrowRight size={16}/></a><a class="hero-contact" href={quote('a dolphin tour')}>Talk to Ayu <ArrowUpRight size={16}/></a></div><p class="hero-footnote">Utami Mesari Tours · Indonesian &amp; English spoken</p></div></section>
    <div class="facts shell"><div><Clock3 size={20}/><span>Departure<strong>Around 06:00</strong></span></div><div><ShipWheel size={20}/><span>Return<strong>Around 08:00–09:00</strong></span></div><div><MapPin size={20}/><span>Hotel pickup<strong>Extra fee by location</strong></span></div></div>
    <section class="section shell intro"><p class="kicker">Dolphin watching with Utami Mesari Tours</p><div class="section-heading"><h2 class="title">Private &amp; sharing<br/>boat options.</h2><div><p class="lede">Our dolphin tour in Lovina offers two choices: join other guests on a sharing boat, or reserve a private boat for your own group. Bu Ayu helps you choose and confirms the arrangements directly.</p><p class="fine">Prices and availability are confirmed for your date and group. Ask about inclusions before booking.</p></div></div></section>
    <section class="shell benefits" aria-labelledby="benefits-title"><div class="benefit-heading"><p class="kicker">What you get with Utami Mesari Tours</p><h2 id="benefits-title">How Ayu helps<br/>plan your tour.</h2></div><div class="benefit-items"><article><span>01</span><h3>Choose a private or sharing boat</h3><p>Share the trip with other guests, or keep the boat just for your group. Choose the arrangement that suits who you’re travelling with.</p></article><article><span>02</span><h3>Direct support in two languages</h3><p>Speak directly with Bu Ayu in Indonesian or English about your tour, transport, and travel plans.</p></article><article><span>03</span><h3>Captain, meeting point &amp; rundown</h3><p>After payment, receive the captain’s details, exact meeting point, and rundown so you know where to go and who to meet.</p></article></div></section>
    <section class="shell boat-grid" id="boats" aria-label="Compare dolphin tour boat options">
      <article class="boat-card"><div class="boat-photo"><img src="/images/dolphin-journey.png" alt="Dolphin tour scenery on the Lovina Sea" loading="lazy"/><span>01 / Join the morning</span></div><div class="boat-body"><p class="kicker">Sharing boat</p><h2>Sharing boat dolphin tour</h2><p>Join other guests on a local boat. Ask Ayu about available departures for your date and the arrangements for adults and children.</p><ul><li><Check size={16}/>Boat shared with other guests</li><li><Check size={16}/>Confirm departure and group capacity</li><li><Check size={16}/>Ask for the price per guest</li></ul><div class="boat-price"><span>Current pricing</span><strong>Request a quote</strong></div><a class="button secondary" href={quote('a sharing boat dolphin tour')}>Ask about sharing <ArrowRight size={15}/></a></div></article>
      <article class="boat-card private"><div class="boat-photo"><img src="/images/lovina-sunrise.png" alt="A traditional boat on calm morning water near Lovina" loading="lazy"/><span>02 / Just your group</span></div><div class="boat-body"><p class="kicker">Private boat</p><h2>Private boat dolphin tour</h2><p>Reserve a boat for your partner, family, or group. Share your guest count so Ayu can confirm a suitable boat and the package details.</p><ul><li><Check size={16}/>Boat reserved for your group</li><li><Check size={16}/>Confirm capacity for your guest count</li><li><Check size={16}/>Ask whether pricing is per boat or person</li></ul><div class="boat-price"><span>Current pricing</span><strong>Request a quote</strong></div><a class="button" href={quote('a private boat dolphin tour')}>Ask about private <ArrowRight size={15}/></a></div></article>
    </section>
    <div class="shell boat-note"><p>Not sure which fits? <a href="/blog/sharing-or-private-boat">Read our sharing vs private boat guide <ArrowUpRight size={14}/></a></p><small>Images illustrate the experience; your exact boat is confirmed with your booking.</small></div>
    <section class="section shell package-scope" id="what-you-get"><div class="section-heading"><div><p class="kicker">The experience &amp; the arrangements</p><h2 class="title">Tour arrangements<br/>&amp; optional extras.</h2></div><p class="lede">Dolphin watching is the focus of the trip. Choose your boat arrangement, then agree on the package details and total price before paying.</p></div><div class="scope-grid"><article><span class="scope-label">Your tour arrangements</span><h3>Dolphin watching &amp; booking support</h3><ul><li>Dolphin-watching trip with a private or sharing boat, according to your booking.</li><li>Help from Ayu in choosing a package for your group.</li><li>Captain, meeting point, and rundown information after payment.</li></ul></article><article><span class="scope-label">Optional extra</span><h3>Hotel pickup at an extra charge</h3><p>Start from your hotel instead of arranging your own journey to the meeting point. Pickup is available for an extra fee based on location.</p><a class="text-link" href={quote('a dolphin tour with hotel pickup')}>Ask for a pickup quote <ArrowRight size={15}/></a></article><article><span class="scope-label">Package-specific details</span><h3>Activities &amp; equipment to confirm</h3><p>Your quote should state the activities, equipment, and facilities included. Meals, drinks, photos, snorkeling, and other extras are not promised on this page; only the agreed package applies.</p><a class="text-link" href="#pricing">See the quote checklist <ArrowRight size={15}/></a></article></div></section>
    <section class="section morning" id="your-morning"><div class="shell morning-grid"><div class="morning-image"><img src="/images/lovina-sunrise.png" alt="Morning light over the sea in Lovina" loading="lazy"/><span>Lovina · North Bali</span></div><div><p class="kicker">A simple outline</p><h2 class="title">Departure &amp;<br/>return times.</h2><ol class="timeline"><li><span>Before departure</span><h3>Meeting point &amp; hotel pickup</h3><p>Follow the meeting point and rundown sent after payment, or take the hotel pickup agreed with Ayu. Pickup costs extra according to location.</p></li><li><span>Around 06:00</span><h3>Depart for dolphin watching</h3><p>The morning is focused on dolphin watching. Confirm the activities and facilities included in your chosen package.</p></li><li><span>Around 08:00–09:00</span><h3>Return &amp; onward transport</h3><p>The return time and duration depend on your package. Confirm any onward transport separately rather than assuming it is included.</p></li></ol><p class="fine">These are approximate timings. Your confirmed booking details take priority.</p><a class="text-link" href="/blog/best-time-to-see-dolphins-in-lovina">Read the tour preparation checklist <ArrowRight size={15}/></a></div></div></section>
    <section class="section shell quote-section" id="pricing"><div><p class="kicker">A clear quote before you commit</p><h2 class="title">Tour prices &amp;<br/>booking details.</h2><p class="lede">Send Ayu your date, guest count, children’s ages, boat preference, and hotel location. Ask for a breakdown of the tour and any pickup charge.</p><a class="button" href={quote('dolphin tour prices and inclusions')}>Get your tour quote <ArrowUpRight size={16}/></a></div><div class="quote-checklist"><h3>What to confirm before payment</h3>{['Total price, currency, and whether it is per person or per boat','Included activities, equipment, and any additional charges','Child rates, age requirements, and suitable boat capacity','Hotel pickup location, time, and cost, if requested','Payment, cancellation, and weather arrangements'].map((item,index)=><div><span>0{index+1}</span><p>{item}</p></div>)}</div></section>
    <section class="section preparation"><div class="shell"><div class="section-heading"><div><p class="kicker">Make the morning work for you</p><h2 class="title">How to prepare<br/>for your boat trip.</h2></div><p class="lede">A little preparation helps you make the most of an early boat trip. These are planning suggestions, not a list of equipment supplied with your package.</p></div><div class="prep-grid"><article><h3>Which boat suits your group?</h3><p>Travelling on your own or as a couple? Sharing lets you join other guests. Want the boat for your family or friends? Private keeps the booking to your group. Compare the total quote for your actual guest count rather than assuming one choice is always cheaper.</p><a class="text-link" href="/blog/sharing-or-private-boat">Compare the two options <ArrowRight size={14}/></a></article><article><h3>Getting to the meeting point</h3><p>Staying around Lovina? Send your hotel location when asking about pickup. Coming from elsewhere in Bali? Arrange transport separately with Ayu and agree on a departure time for your origin. The boat’s approximate 06:00 start is not your hotel pickup time.</p><a class="text-link" href="/#transport">Explore transport options <ArrowRight size={14}/></a></article><article><h3>What to bring on the boat</h3><p>Consider sun protection, a light layer for the early start, drinking water, and a splash-resistant pouch for your phone. Ask what is supplied before deciding what to bring. Keep your booking details and captain’s contact easy to access.</p><a class="text-link" href="/blog/best-time-to-see-dolphins-in-lovina">Read the morning guide <ArrowRight size={14}/></a></article></div><div class="after-tour"><div><p class="kicker">After the boat trip</p><h3>Sightseeing after your dolphin tour</h3><p>Ask about Banjar Hot Spring, local sightseeing, or a waterfall visit as a separate plan. The route, timing, transport, and price are agreed separately; these stops are not automatically part of the dolphin tour.</p></div><a class="text-link" href="/blog/a-slow-day-in-north-bali">Ideas for a slower day <ArrowRight size={15}/></a></div></div></section>
    <section class="section shell booking-process" id="booking"><div class="section-heading"><div><p class="kicker">From your first message to departure</p><h2 class="title">How to book your<br/>dolphin tour.</h2></div><p class="lede">Arrange your trip directly with Bu Ayu. Follow these steps to choose your boat, agree on the details, and receive your departure information.</p></div><ol class="booking-flow"><li><span>01</span><h3>Send your date &amp; group size</h3><p>Message Ayu with your travel date, number of adults and children, children’s ages, and preferred boat type. Include your hotel location if you need pickup.</p></li><li><span>02</span><h3>Agree on the package &amp; payment</h3><p>Choose the private or sharing option. Confirm the total price, inclusions, any pickup charge, payment arrangements, and cancellation or weather terms before paying.</p></li><li><span>03</span><h3>Receive your departure details</h3><p>After payment, Ayu shares the captain’s details, exact meeting point, and rundown. Keep these details ready for the morning of your trip.</p></li><li><span>04</span><h3>Meet up or take your pickup</h3><p>Follow your agreed meeting time, or be ready for the hotel pickup arranged with Ayu. The meeting time and pickup time may be earlier than the boat’s departure.</p></li></ol><a class="button" href={quote('booking a dolphin tour')}>Start your booking with Ayu <ArrowUpRight size={16}/></a></section>
    <section class="section travel-support" id="travel-support"><div class="shell"><div class="section-heading"><div><p class="kicker">Separate arrangements, one contact</p><h2 class="title">Transport &amp; help<br/>planning your stay.</h2></div><p class="lede">Need more than the boat trip? Ayu also helps with transport, hotel and villa recommendations, and local itinerary planning. These are arranged separately from your dolphin tour.</p></div><div class="support-grid"><article><MapPin size={22}/><h3>Transport from your area</h3><p>Transport services cover Lovina, Singaraja, Negara, and Denpasar. Share your exact starting point to discuss the journey to Lovina, pickup time, and price. Travel time depends on your route and road conditions.</p><a class="text-link" href="/#transport">See our transport services <ArrowRight size={15}/></a></article><article><ShipWheel size={22}/><h3>Cars for families &amp; groups</h3><p>Family-car options include Terios, Avanza, Xpander, and Xenia. Hiace and Elf are options for larger groups. Tell Ayu your passenger count and luggage needs to agree on a suitable vehicle.</p><a class="text-link" href={quote('transport for our dolphin tour group')}>Discuss your group transport <ArrowRight size={15}/></a></article><article><MapPin size={22}/><h3>Hotels, villas &amp; itinerary help</h3><p>Ask Ayu for hotel or villa recommendations and help planning your time around Lovina. Discuss where you’ll stay, your dolphin tour morning, and any separate sightseeing you would like to arrange.</p><a class="text-link" href="/blog/a-slow-day-in-north-bali">Explore North Bali trip ideas <ArrowRight size={15}/></a></article></div><p class="support-note">Transport, accommodation costs, and additional sightseeing are not automatically included in the boat quote. Agree on each arrangement before booking.</p></div></section>
    <section class="section host-section"><div class="shell host-card"><img src="/images/buk-ayu.jpeg" width="908" height="1600" alt="Bu Ayu, owner of Utami Mesari Tours" loading="lazy"/><div><p class="kicker">Your contact, from the first message</p><h2>Bu Ayu, your tour contact.</h2><p>Bu Ayu is the owner behind Utami Mesari Tours. Through her work in insurance, which began in 2010, she developed relationships with hotels, villas, and dolphin tour operators. Today she helps guests arrange tours and transport around Lovina.</p><p>Speak with her in Indonesian or English about your boat, hotel pickup, and travel plans.</p><a class="text-link" href={business.whatsappUrl}>Chat with Bu Ayu <ArrowUpRight size={16}/></a><a class="host-more" href="/#about">More about Ayu and Utami Mesari Tours</a><a class="host-more" href={business.instagramUrl} target="_blank" rel="noreferrer">Find us on Instagram: {business.instagramHandle} <ArrowUpRight size={13}/></a></div></div></section>
    <section class="section shell faq-section" id="questions"><div><p class="kicker">Good to know</p><h2 class="title">Dolphin tour<br/>FAQs.</h2><p class="lede">Still have a question? <a href={business.whatsappUrl}>Ask Bu Ayu directly.</a></p></div><div class="tour-faq">{faqs.map((faq,index)=><details open={index===0}><summary><span class="faq-number">0{index+1}</span><span>{faq.q}</span><span class="faq-icon" aria-hidden="true"></span></summary><div class="faq-answer"><p>{faq.a}</p></div></details>)}</div></section>
    <section class="section shell more-reading"><div class="section-heading"><div><p class="kicker">Keep planning</p><h2 class="title">Guides to choosing<br/>&amp; planning your tour.</h2></div><a class="text-link" href="/gallery#dolphins">Explore the dolphin gallery <ArrowRight size={16}/></a></div><div class="reading-grid"><a href="/blog/sharing-or-private-boat"><img src="/images/lovina-sunrise.png" alt="Traditional boat near Lovina" loading="lazy"/><div><small>Trip planning</small><h3>Sharing vs private boat guide</h3><span>Find your fit <ArrowRight size={16}/></span></div></a><a href="/blog/best-time-to-see-dolphins-in-lovina"><img src="/images/lovina-dolphins-hero.webp" alt="Dolphins at sunrise on the Lovina Sea" loading="lazy"/><div><small>Sea notes</small><h3>Lovina dolphin tour preparation</h3><span>Read the morning guide <ArrowRight size={16}/></span></div></a></div></section>
    <section class="closing"><div class="shell"><p class="kicker">Let’s plan your morning</p><h2>Request your<br/>dolphin tour quote.</h2><p>Send your date and group size.<br/>Ayu will help you with the next steps.</p><a class="button light" href={quote('a dolphin tour')}>Plan with Bu Ayu <ArrowUpRight size={17}/></a><a class="closing-phone" href={business.whatsappUrl}>{business.phone}</a></div></section>
  </main>
  <footer class="shell tour-footer"><a href="/">Utami Mesari Tours</a><nav aria-label="Footer"><a href="/#transport">Transport</a><a href="/blog">Journal</a><a href="/gallery">Gallery</a></nav><p>Last updated: <time datetime={updated}>1 November 2026</time></p></footer>
  <script>
    const menu = document.querySelector<HTMLButtonElement>('.tour-menu')!;
    const mobile = document.querySelector<HTMLElement>('#tour-mobile')!;
    const closeMenu = () => { mobile.hidden = true; menu.setAttribute('aria-expanded','false'); menu.setAttribute('aria-label','Open navigation'); };
    menu.addEventListener('click', () => { mobile.hidden = !mobile.hidden; menu.setAttribute('aria-expanded',String(!mobile.hidden)); menu.setAttribute('aria-label', mobile.hidden ? 'Open navigation' : 'Close navigation'); });
    mobile.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu));
    document.addEventListener('keydown', event=>{if(event.key==='Escape') closeMenu();});
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll<HTMLDetailsElement>('.tour-faq details').forEach(details=>{
      const summary=details.querySelector('summary')!;const answer=details.querySelector<HTMLElement>('.faq-answer')!;
      let expanded=details.open;let animation:Animation|undefined;
      summary.setAttribute('aria-expanded',String(expanded));
      summary.addEventListener('click',event=>{event.preventDefault();const from=details.getBoundingClientRect().height;animation?.cancel();expanded=!expanded;summary.setAttribute('aria-expanded',String(expanded));details.classList.toggle('is-closing',!expanded);details.open=true;const to=summary.getBoundingClientRect().height+(expanded?answer.getBoundingClientRect().height:0);if(reduced.matches){details.open=expanded;details.classList.remove('is-closing');return;}animation=details.animate([{height:`${from}px`},{height:`${to}px`}],{duration:360,easing:'cubic-bezier(.22,1,.36,1)'});animation.onfinish=()=>{details.open=expanded;details.classList.remove('is-closing');animation=undefined;};});
    });
  </script>
</BaseLayout>
<style>
  section[id]{scroll-margin-top:95px}.tour-header{position:absolute;inset:0 0 auto;z-index:20;color:white;border-bottom:1px solid #ffffff33}.tour-nav{height:80px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.tour-brand{display:flex;align-items:center;gap:.7rem}.tour-brand>span{display:grid;place-items:center;width:33px;height:33px;border-radius:50%;background:white;color:var(--ink);font-weight:600}.tour-brand strong{font-size:.8rem;font-weight:500}.tour-brand small{display:block;font-size:.55rem;text-transform:uppercase;letter-spacing:.13em;margin-top:.25rem;color:#d7e2df}.tour-nav nav{display:flex;gap:1.8rem;font-size:.75rem}.nav-book{background:white;color:var(--ink);border-color:white}.tour-menu{display:none}.tour-mobile{background:var(--ink);padding:1.5rem;gap:1rem}.tour-mobile:not([hidden]){display:flex;flex-direction:column}.tour-mobile[hidden]{display:none}
  .tour-hero{position:relative;min-height:740px;height:90svh;max-height:1000px;color:white;display:flex;align-items:center;isolation:isolate}.hero-photo{position:absolute;inset:0;height:100%;object-fit:cover;object-position:65% center;z-index:-2}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,#071e23d9,#071e2377 48%,#071e231a),linear-gradient(0deg,#071e2377,transparent 55%);z-index:-1}.hero-content{padding-top:70px}.breadcrumbs{display:flex;gap:.7rem;font-size:.65rem;color:#d1dfdb;margin-bottom:3rem}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.64rem;color:#d3dfd7;margin:0 0 1.4rem}.tour-hero h1{font-weight:400;font-size:clamp(4rem,7.4vw,7rem);line-height:1.02;letter-spacing:-.06em;margin:0}.tour-hero h1>span{color:#e1ccab}.hero-intro{font-size:1.05rem;line-height:1.8;max-width:45ch;color:#dbe5e0;margin:1.8rem 0}.hero-actions{display:flex;gap:1.8rem;align-items:center}.light{background:white;color:var(--ink);border-color:white}.light:hover{background:#dfd8c6;color:var(--ink);border-color:#dfd8c6}.hero-contact{display:flex;gap:.5rem;align-items:center;font-size:.8rem;border-bottom:1px solid #ffffff77;padding:.6rem 0}.hero-footnote{font-size:.63rem;color:#c5d5cd;margin-top:2rem}.facts{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line);padding-block:2rem;gap:2rem}.facts>div{display:flex;align-items:center;gap:1rem}.facts>div+div{border-left:1px solid var(--line);padding-left:2rem}.facts span{font-size:.66rem;color:var(--muted)}.facts strong{display:block;color:var(--ink);font-size:.95rem;font-weight:500;margin-top:.4rem}
