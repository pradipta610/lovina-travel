---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, BusFront, Check, MapPin, Menu, ShipWheel, Sparkles, Star, X } from 'lucide-astro';

import { business } from '../data/business';
const { whatsappUrl } = business;

const tours = [
  { number: '01', title: 'Sharing Dolphin Tour', price: 'Ask for a quote', note: 'A morning on the Lovina Sea aboard a shared local boat.', items: ['Dolphin watching', 'Shared boat', 'Ask about adult & child options'] },
  { number: '02', title: 'Private Dolphin Tour', price: 'Ask for a quote', note: 'Your own boat for a morning with your partner, family, or group.', items: ['Dolphin watching', 'Private boat', 'Confirm your group size with Ayu'] },
  { number: '03', title: 'Plan Your Morning', price: 'Ask for a quote', note: 'Let Ayu help match your dolphin tour and transport to your travel plans.', items: ['Tour package advice', 'Hotel pickup at an extra charge', 'Hotel & villa recommendations'] },
];

const privateRates = [['Departure', 'Around 06:00'], ['Return', 'Around 08:00–09:00'], ['Duration', 'Depends on your package'], ['Hotel pickup', 'Extra fee by location']];
const routes = [['Lovina', 'Ask for a quote'], ['Singaraja', 'Ask for a quote'], ['Negara', 'Ask for a quote'], ['Denpasar', 'Ask for a quote'], ['Airport transfers', 'Ask for a quote']];
const reviews = [
  { name: 'Emily R.', origin: 'Australia', text: 'A calm, beautiful morning. Ayu made everything easy, from the pickup to finding the boat.' },
  { name: 'Daniel K.', origin: 'Germany', text: 'Clear communication, fair pricing, and a lovely captain. The dolphins were unforgettable.' },
  { name: 'Sophie M.', origin: 'France', text: 'We combined snorkeling with the dolphin tour and never felt rushed. Highly recommended.' },
];
---

<BaseLayout>
  <header class="header" data-header>
    <div class="shell nav">
      <a class="brand" href="#top"><span class="brand-mark">L</span><span>Lovina Travel<small>North Bali</small></span></a>
      <nav class="nav-links" aria-label="Main navigation"><a href="#tours">Sea tours</a><a href="#transport">Transport</a><a href="/gallery">Gallery</a><a href="#about">About</a><a href="/blog">Journal</a></nav>
      <a class="button nav-cta" href={whatsappUrl}>Plan a trip <ArrowRight size={14}/></a>
      <button class="menu-button" aria-label="Open menu" aria-expanded="false"><span>Menu</span><Menu class="icon-open" size={18}/><X class="icon-close" size={18}/></button>
    </div>
    <div class="mobile-nav"><a href="#tours">Sea tours</a><a href="#transport">Transport</a><a href="/gallery">Gallery</a><a href="#about">About Ayu</a><a href="/blog">Journal</a><a href={whatsappUrl}>Contact</a></div>
  </header>

  <main>
    <section class="hero" id="top">
      <img class="hero-image" src="/images/lovina-dolphins-hero.webp" alt="A pod of dolphins surfacing beside a traditional boat at sunrise in Lovina" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-copy shell reveal">
        <p class="hero-kicker">North Bali · Sea tours & local travel</p>
        <h1>Lovina</h1>
        <p>Dolphin tours at sunrise, private transport,<br/>and local travel help from Bu Ayu.</p>
        <a class="hero-button" href="#tours">Explore sea tours <ArrowRight size={15}/></a>
      </div>
      <div class="hero-meta shell"><span>08°09' S · 115°01' E</span><span>Scroll to explore</span></div>
    </section>

    <section class="tour-section section" id="tours">
      <div class="shell section-heading reveal"><div><p class="kicker">Sea tours</p><h2 class="title">Choose your morning.</h2></div><p class="lede">Depart around 06:00 and return around 08:00–09:00, depending on your package. Contact Ayu for current prices and inclusions.</p></div>
      <div class="shell tour-grid">
        {tours.map((tour) => (
          <article class:list={['tour-card reveal', { featured: tour.number === '02' }]}>
            <div class="card-top"><span>{tour.number}</span></div>
            <h3>{tour.title}</h3><p class="price">{tour.price}</p><p class="card-note">{tour.note}</p>
            <ul>{tour.items.map((item) => <li><Check size={15}/>{item}</li>)}</ul>
            <a href={whatsappUrl}>Ask about this tour <ArrowRight size={14}/></a>
          </article>
        ))}
      </div>
    </section>

    <section class="private-section section">
      <div class="shell private-grid">
        <div class="private-image reveal"><img src="/images/lovina-sunrise.png" alt="A private traditional boat on the calm Lovina Sea" loading="lazy" /><span>Private means your pace.</span></div>
        <div class="private-copy reveal"><p class="kicker">Private boat</p><h2 class="title">A quieter way<br/>to go.</h2><p class="lede">Your own boat, a flexible morning, and more room to enjoy the sea with your group.</p>
          <div class="rate-list">{privateRates.map(([group, rate]) => <div><span>{group}</span><strong>{rate}</strong></div>)}</div>
          <a class="button" href={whatsappUrl}>Book a private boat <ArrowRight size={14}/></a>
        </div>
      </div>
    </section>

    <section class="transport section" id="transport">
      <div class="shell section-heading reveal"><div><p class="kicker">On the road</p><h2 class="title">Transport, kept simple.</h2></div><p class="lede">Private cars, Hiace, and Elf serving Lovina, Singaraja, Negara, Denpasar, and airport transfers. Long-term car and motorbike rentals are also available.</p></div>
      <div class="shell transport-grid">
        <article class="transport-card reveal"><BusFront size={24}/><h3>Private car</h3><p>Terios, Avanza, Xpander, or Xenia for solo travellers, couples, and families. Ask about a female driver when booking.</p></article>
        <article class="transport-card reveal"><ShipWheel size={24}/><h3>HiAce or ELF</h3><p>Hiace seats up to 15 passengers plus a driver; Elf seats up to 19 plus a driver. For group outings, arisan, and tirta yatra.</p></article>
        <article class="transport-card reveal"><Sparkles size={24}/><h3>Long-term rentals</h3><p>Car and motorbike rentals for longer stays. Contact Ayu for availability, rental terms, and pricing.</p></article>
      </div>
      <div class="shell route-table reveal"><div class="table-title"><span class="kicker">Popular routes</span><span>Pricing</span></div>{routes.map(([route, price]) => <div class="route-row"><span>{route}</span><strong>{price}</strong></div>)}<p>Share your pickup point, destination, date, and group size for a transport quote.</p></div>
    </section>

    <section class="about section" id="about">
      <div class="shell about-grid">
        <div class="about-image reveal"><img src="/images/hidden-waterfall.png" alt="A quiet trail leading to a waterfall in North Bali" loading="lazy" /></div>
        <div class="about-copy reveal"><p class="kicker">Your local contact</p><h2 class="title">Bu Ayu.</h2><p class="about-lead">From an insurance career in 2010 to local tours and transport.</p><p class="lede">Through her work in insurance, Ayu built relationships with business clients, hotels, villas, and dolphin tour operators. Today she helps couples, families, groups, and solo travellers plan their time in Lovina, with support in Indonesian and English.</p>
          <div class="about-points"><span><Check size={15}/> Local itinerary help</span><span><Check size={15}/> Hotel & villa recommendations</span><span><Check size={15}/> Indonesian & English spoken</span></div>
          <a class="button" href={whatsappUrl}>Talk to Ayu <ArrowRight size={14}/></a>
        </div>
      </div>
    </section>

    <section class="gallery-preview section" id="gallery-preview">
      <div class="shell gallery-heading reveal">
        <div><p class="kicker">From the gallery</p><h2 class="title">A glimpse of<br/>the journey.</h2></div>
        <div><p class="lede">Mornings on the sea, family-sized rides, and more room when everyone is coming along.</p><a href="/gallery">View the full gallery <ArrowRight size={14}/></a></div>
      </div>
      <div class="shell gallery-teasers">
        <a class="gallery-teaser dolphin reveal" href="/gallery#dolphins"><img src="/images/dolphin-journey.png" alt="Dolphin tour on the Lovina Sea" loading="lazy"/><span><small>01 · At sea</small>Dolphin tour <ArrowRight size={15}/></span></a>
        <a class="gallery-teaser reveal" href="/gallery#family-transport"><img src="/images/family-transport.webp" alt="White family transport in North Bali" loading="lazy"/><span><small>02 · On the road</small>Family transport <ArrowRight size={15}/></span></a>
        <a class="gallery-teaser reveal" href="/gallery#group-transport"><img src="/images/group-transport.webp" alt="Group transport vehicles in North Bali" loading="lazy"/><span><small>03 · More room</small>Group transport <ArrowRight size={15}/></span></a>
      </div>
    </section>

    <section class="reviews section" id="reviews">
      <div class="shell review-heading">
        <div><p class="kicker">Google reviews</p><h2 class="title">Words from the water.</h2></div>
        <div class="rating"><strong>4.9</strong><span class="stars" aria-label="5 out of 5 stars">{Array.from({ length: 5 }).map(() => <Star size={16} fill="currentColor" />)}</span><small>Sample review content</small></div>
      </div>
      <div class="shell review-grid">
        {reviews.map((review) => <article class="review-card"><div class="stars">{Array.from({ length: 5 }).map(() => <Star size={13} fill="currentColor" />)}</div><p>“{review.text}”</p><footer><strong>{review.name}</strong><span>{review.origin}</span></footer></article>)}
      </div>
      <div class="shell map-wrap">
        <div class="map-frame"><iframe title="Map showing Lovina Beach, North Bali" src="https://www.google.com/maps?q=Lovina%20Beach%2C%20Bali&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
        <div class="map-copy"><MapPin size={22}/><p class="kicker">Find us in the north</p><h3>Lovina Beach,<br/>North Bali.</h3><p>Your captain, meeting point, and full rundown are shared after payment. Hotel pickup is available at an extra charge depending on location.</p><a class="button secondary" href="https://maps.google.com/?q=Lovina+Beach+Bali" target="_blank" rel="noreferrer">Open in Google Maps <ArrowRight size={14}/></a></div>
      </div>
    </section>

    <section class="contact section" id="contact"><div class="shell contact-inner reveal"><p class="kicker">Start here</p><h2>Tell us when you’re coming.</h2><p>Send your date, number of guests, pickup location, and the experience you want. We’ll help with the rest.</p><a class="button contact-button" href={whatsappUrl}>Chat with Bu Ayu <ArrowRight size={15}/></a><p class="contact-details"><a href={whatsappUrl}>{business.phone}</a><br/>Indonesian &amp; English · <a href={business.instagramUrl} target="_blank" rel="noreferrer">{business.instagramHandle}</a></p></div></section>
  </main>

  <footer class="site-footer"><div class="shell footer-inner"><a class="brand footer-brand" href="#top"><span class="brand-mark">L</span><span>Lovina Travel<small>North Bali</small></span></a><p>Dolphin tours & transport · Lovina, North Bali.</p><span>© 2026 Lovina Travel</span></div></footer>

  <script>
    const header = document.querySelector<HTMLElement>('[data-header]');
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
    const syncHeader = () => header?.classList.toggle('scrolled', window.scrollY > 48);
    syncHeader();
    window.addEventListener('scroll', syncHeader, { passive: true });
    const closeMenu = () => { header?.classList.remove('open'); menuButton?.setAttribute('aria-expanded','false'); document.body.classList.remove('menu-open'); };
    menuButton?.addEventListener('click', () => { const open = !header?.classList.contains('open'); header?.classList.toggle('open', open); menuButton.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-open', open); });
    document.querySelectorAll('.mobile-nav a').forEach((link) => link.addEventListener('click', closeMenu));
  </script>
</BaseLayout>

<style>
  .header{position:fixed;inset:0 0 auto;z-index:50;color:var(--white);background:transparent;border-bottom:1px solid rgba(255,255,255,.25);transition:background .3s ease,color .3s ease,border-color .3s ease,box-shadow .3s ease;backdrop-filter:blur(0)}.nav{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{display:flex;align-items:center;gap:.7rem;width:max-content;font-size:.86rem;font-weight:600;letter-spacing:-.02em}.brand-mark{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--white);color:var(--ink);transition:.3s ease}.brand small{display:block;color:rgba(255,255,255,.72);font-size:.58rem;font-weight:500;letter-spacing:.13em;text-transform:uppercase;margin-top:.1rem;transition:color .3s ease}.nav-links{display:flex;gap:2rem;font-size:.76rem;color:rgba(255,255,255,.85)}.nav-links a:hover{color:var(--white)}.nav-cta{justify-self:end;min-height:40px;padding:.5rem 1rem;background:var(--white);border-color:var(--white);color:var(--ink)}.nav-cta:hover{background:transparent;color:var(--white)}.menu-button,.mobile-nav{display:none}.header.scrolled{color:var(--ink);background:rgba(246,247,243,.94);border-color:var(--line);box-shadow:0 8px 30px rgba(21,56,59,.06);backdrop-filter:blur(14px)}.header.scrolled .brand-mark{background:var(--ink);color:var(--white)}.header.scrolled .brand small,.header.scrolled .nav-links{color:var(--muted)}.header.scrolled .nav-links a:hover{color:var(--ink)}.header.scrolled .nav-cta{background:var(--ink);border-color:var(--ink);color:var(--white)}.header.scrolled .nav-cta:hover{background:var(--sea);border-color:var(--sea);color:var(--white)}
  .hero{height:100svh;min-height:680px;position:relative;display:grid;place-items:center;overflow:hidden;background:var(--ink);color:var(--white)}.hero-image{position:absolute;inset:0;height:100%;object-fit:cover;object-position:center 52%}.hero-shade{position:absolute;inset:0;background:radial-gradient(ellipse 54% 48% at 50% 55%,rgba(6,29,32,.38) 0%,rgba(6,29,32,.2) 48%,transparent 78%),linear-gradient(180deg,rgba(6,27,30,.42) 0%,rgba(6,27,30,.08) 34%,rgba(6,27,30,.12) 58%,rgba(6,27,30,.52) 100%)}.hero-copy{position:relative;z-index:2;text-align:center;margin-top:3rem}.hero-kicker{margin:0 0 1.2rem;font-size:.68rem;font-weight:500;letter-spacing:.15em;text-transform:uppercase;text-shadow:0 2px 18px rgba(3,18,20,.32)}.hero-copy h1{font-size:clamp(6.5rem,15vw,13rem);font-weight:500;line-height:.78;letter-spacing:-.085em;margin:0;text-shadow:0 3px 32px rgba(3,18,20,.28)}.hero-copy>p{font-size:clamp(.95rem,1.6vw,1.25rem);font-weight:500;line-height:1.45;margin:2rem auto 1.7rem;text-shadow:0 2px 20px rgba(3,18,20,.42)}.hero-button{display:inline-flex;align-items:center;gap:.65rem;min-height:48px;padding:.75rem 1.25rem;border-radius:999px;background:var(--white);color:var(--ink);font-size:.76rem;font-weight:600;transition:.25s}.hero-button:hover{transform:translateY(-2px);background:var(--sea);color:var(--white)}.hero-meta{position:absolute;z-index:2;bottom:1.5rem;left:50%;transform:translateX(-50%);display:flex;justify-content:space-between;font-size:.61rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.82);text-shadow:0 2px 16px rgba(3,18,20,.38)}
  .tour-section{background:var(--white)}.section-heading{display:grid;grid-template-columns:1.6fr 1fr;gap:4rem;align-items:end;margin-bottom:3rem}.section-heading .kicker{margin-bottom:1rem}.section-heading .lede{margin:0}.tour-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.tour-card{padding:1.5rem;border:1px solid var(--line);border-radius:1rem;background:var(--white);display:flex;flex-direction:column;min-height:465px}.tour-card.featured{background:var(--ink);color:var(--white);border-color:var(--ink)}.card-top{display:flex;justify-content:space-between;font-size:.65rem;color:var(--muted)}.featured .card-top{color:#b8cbcb}.popular{padding:.35rem .55rem;border:1px solid currentColor;border-radius:999px;text-transform:uppercase;letter-spacing:.08em}.tour-card h3{font-size:1.45rem;font-weight:500;letter-spacing:-.035em;margin:2.5rem 0 1.1rem}.price{font-size:1.8rem;margin:0}.price small{font-size:.7rem;font-weight:400;color:var(--muted);margin-left:.35rem}.featured .price small,.featured .card-note{color:#b8cbcb}.card-note{min-height:70px;color:var(--muted);font-size:.82rem;line-height:1.6}.tour-card ul{list-style:none;padding:1.2rem 0;margin:1rem 0;border-top:1px solid var(--line);display:grid;gap:.7rem}.featured ul{border-color:#496365}.tour-card li{display:flex;gap:.55rem;align-items:center;font-size:.75rem}.tour-card>a{margin-top:auto;display:flex;align-items:center;justify-content:space-between;padding-top:1rem;border-top:1px solid var(--line);font-size:.72rem;font-weight:500}.featured>a{border-color:#496365}
  .private-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(3rem,8vw,8rem);align-items:center}.private-image{height:660px;position:relative;border-radius:1rem;overflow:hidden}.private-image img{height:100%;object-fit:cover}.private-image span{position:absolute;inset:auto 1rem 1rem;padding:.55rem .75rem;border-radius:999px;background:var(--white);font-size:.68rem}.private-copy .kicker{margin-bottom:1rem}.private-copy .lede{max-width:45ch}.rate-list{margin:2rem 0}.rate-list div{display:flex;justify-content:space-between;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.85rem}.rate-list strong{font-weight:500}
  .transport{background:var(--mist)}.transport-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.transport-card{padding:1.5rem;background:var(--paper);border-radius:.9rem}.transport-card h3{font-size:1.1rem;margin:2.7rem 0 .8rem}.transport-card p{color:var(--muted);font-size:.78rem;line-height:1.65;margin:0}.route-table{margin-top:3.5rem;background:var(--paper);border-radius:1rem;padding:1rem 1.5rem}.table-title,.route-row{display:flex;justify-content:space-between;align-items:center}.table-title{padding:1rem 0 1.3rem;border-bottom:1px solid var(--line);font-size:.68rem;color:var(--muted)}.route-row{padding:1rem 0;border-bottom:1px solid var(--line);font-size:.82rem}.route-row strong{font-weight:500}.route-table>p{color:var(--muted);font-size:.67rem;margin:1rem 0 .3rem}
  .about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,9vw,9rem);align-items:center}.about-image{height:650px;border-radius:1rem;overflow:hidden}.about-image img{height:100%;object-fit:cover}.about-copy .kicker{margin-bottom:1rem}.about-lead{font-size:1.2rem;margin:1.5rem 0}.about-copy>.lede{max-width:56ch}.about-points{display:grid;gap:.8rem;margin:2rem 0 2.5rem}.about-points span{display:flex;align-items:center;gap:.55rem;font-size:.77rem}
  .gallery-preview{background:var(--ink);color:var(--white)}.gallery-heading{display:grid;grid-template-columns:1.25fr .75fr;gap:4rem;align-items:end;margin-bottom:3rem}.gallery-heading .kicker{margin-bottom:1rem;color:#b5d0ce}.gallery-heading .lede{margin:0;color:#b5c5c5}.gallery-heading>div:last-child>a{width:max-content;display:flex;align-items:center;gap:.55rem;margin-top:1.6rem;padding-bottom:.35rem;border-bottom:1px solid #6e8888;font-size:.72rem}.gallery-teasers{display:grid;grid-template-columns:1.25fr .75fr .75fr;gap:1rem}.gallery-teaser{height:440px;position:relative;overflow:hidden;border-radius:.9rem}.gallery-teaser img{height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.16,1,.3,1)}.gallery-teaser:after{content:'';position:absolute;inset:42% 0 0;background:linear-gradient(transparent,rgba(5,25,27,.78))}.gallery-teaser>span{position:absolute;z-index:1;inset:auto 1rem 1rem;display:grid;grid-template-columns:1fr auto;align-items:end;font-size:1.05rem}.gallery-teaser small{grid-column:1/-1;margin-bottom:.35rem;color:#d1dfdc;font-size:.58rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase}.gallery-teaser:hover img{transform:scale(1.025)}
  .reviews{background:var(--white)}.review-heading{display:grid;grid-template-columns:1fr auto;gap:3rem;align-items:end}.review-heading .kicker{margin-bottom:1rem}.rating{text-align:right}.rating strong{display:block;font-size:3rem;font-weight:500;letter-spacing:-.06em;line-height:1}.stars{display:flex;gap:.18rem;color:var(--sun)}.rating .stars{justify-content:flex-end;margin:.55rem 0}.rating small{color:var(--muted);font-size:.63rem}.review-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.review-card{padding:1.5rem;border:1px solid var(--line);border-radius:1rem;background:var(--paper)}.review-card>p{min-height:105px;font-size:.88rem;line-height:1.7}.review-card footer{display:flex;justify-content:space-between;padding-top:1rem;border-top:1px solid var(--line);font-size:.7rem}.review-card footer strong{font-weight:600}.review-card footer span{color:var(--muted)}.map-wrap{display:grid;grid-template-columns:1.45fr .55fr;margin-top:5rem;border:1px solid var(--line);border-radius:1rem;overflow:hidden}.map-frame{min-height:480px;background:var(--mist)}.map-frame iframe{width:100%;height:100%;min-height:480px;border:0;filter:saturate(.75) contrast(.95)}.map-copy{padding:clamp(2rem,5vw,4rem);display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.map-copy .kicker{margin:1.5rem 0 1rem}.map-copy h3{font-size:clamp(2rem,4vw,3.6rem);font-weight:400;line-height:1;letter-spacing:-.05em;margin:0}.map-copy>p:not(.kicker){color:var(--muted);font-size:.78rem;line-height:1.7;margin:1.5rem 0 2rem}
  .contact{background:var(--ink);color:var(--white);text-align:center}.contact-inner{max-width:780px}.contact .kicker{color:#b5d0ce}.contact h2{font-size:clamp(3.2rem,7vw,6.5rem);font-weight:400;line-height:.95;letter-spacing:-.06em;margin:1.5rem 0}.contact p:not(.kicker){max-width:52ch;margin:0 auto 2.2rem;color:#b5c5c5;line-height:1.7}.contact .contact-details{margin:1.5rem auto 0;font-size:.85rem}.contact-details a{text-decoration:underline;text-underline-offset:4px}.contact-button{background:var(--white);color:var(--ink);border-color:var(--white)}.contact-button:hover{background:var(--white);color:var(--sea);border-color:var(--white)}
