---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, BusFront, Check, MapPin, Menu, ShipWheel, Sparkles, X } from 'lucide-astro';

import { posts } from '../data/posts';
import { business } from '../data/business';
const { whatsappUrl } = business;

const tours = [
  { number: '01', title: 'Sharing Dolphin Tour', price: 'Ask for a quote', note: 'A morning on the Lovina Sea aboard a shared local boat.', items: ['Dolphin watching', 'Shared boat', 'Ask about adult & child options'] },
  { number: '02', title: 'Private Dolphin Tour', price: 'Ask for a quote', note: 'Your own boat for a morning with your partner, family, or group.', items: ['Dolphin watching', 'Private boat', 'Confirm your group size with Ayu'] },
  { number: '03', title: 'Plan Your Morning', price: 'Ask for a quote', note: 'Let Ayu help match your dolphin tour and transport to your travel plans.', items: ['Tour package advice', 'Hotel pickup at an extra charge', 'Hotel & villa recommendations'] },
];

const privateRates = [['Departure', 'Around 06:00'], ['Return', 'Around 08:00–09:00'], ['Duration', 'Depends on your package'], ['Hotel pickup', 'Extra fee by location']];
const routes = [['Lovina', 'Ask for a quote'], ['Singaraja', 'Ask for a quote'], ['Negara', 'Ask for a quote'], ['Denpasar', 'Ask for a quote'], ['Airport transfers', 'Ask for a quote']];
const updatedAt = '2026-10-25';
const pageData = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  '@id': new URL('/#webpage', Astro.site).href,
  url: Astro.site!.href,
  name: 'Utami Mesari Tours | Lovina Dolphin Tours & Transport',
  description: 'Plan Lovina dolphin tours, private transport and North Bali trips with Bu Ayu at Utami Mesari Tours.',
  dateModified: updatedAt,
  inLanguage: 'en',
  about: { '@id': new URL('/#business', Astro.site).href },
  isPartOf: { '@id': new URL('/#website', Astro.site).href },
};

---

<BaseLayout title="Utami Mesari Tours | Lovina Dolphin Tours & Transport" description="Plan Lovina dolphin tours, private transport and North Bali trips with Bu Ayu at Utami Mesari Tours. Contact us in Indonesian or English for a quote.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageData).replace(/</g, '\u003c')} />
  <header class="header" data-header>
    <div class="shell nav">
      <a class="brand" href="#top"><span class="brand-mark">U</span><span>Utami Mesari Tours<small>Lovina · North Bali</small></span></a>
      <nav class="nav-links" aria-label="Main navigation"><a href="#tours">Sea tours</a><a href="#transport">Transport</a><a href="/gallery">Gallery</a><a href="#about">About</a><a href="/blog">Journal</a></nav>
      <a class="button nav-cta" href={whatsappUrl}>Plan a trip <ArrowRight size={14}/></a>
      <button class="menu-button" aria-label="Open menu" aria-expanded="false"><span>Menu</span><Menu class="icon-open" size={18}/><X class="icon-close" size={18}/></button>
    </div>
    <div class="mobile-nav"><a href="#tours">Sea tours</a><a href="#transport">Transport</a><a href="/gallery">Gallery</a><a href="#about">About Ayu</a><a href="/blog">Journal</a><a href={whatsappUrl}>Contact</a></div>
  </header>

  <main>
    <section class="hero" id="top">
      <img class="hero-image" src="/images/lovina-dolphins-hero.webp" alt="A pod of dolphins surfacing beside a traditional boat at sunrise in Lovina" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-copy shell reveal">
        <p class="hero-kicker">Lovina, North Bali · With Bu Ayu</p>
        <h1 class="brand-heading">Utami Mesari <span>Tours</span></h1>
        <p>Lovina dolphin tours, private transport,<br/> and North Bali travel help from Bu Ayu.</p>
        <a class="hero-button" href="/dolphin-tour-lovina/">Explore sea tours <ArrowRight size={15}/></a>
      </div>
      <div class="hero-meta shell"><span>08°09' S · 115°01' E</span><span>Scroll to explore</span></div>
    </section>

    <section class="tour-section section" id="tours">
      <div class="shell section-heading reveal"><div><p class="kicker">Sea tours</p><h2 class="title">Dolphin tours in Lovina.</h2></div><p class="lede">Depart around 06:00 and return around 08:00–09:00, depending on your package. Contact Ayu for current prices and inclusions.</p></div>
      <div class="shell tour-grid">
        {tours.map((tour) => (
          <article class:list={['tour-card reveal', { featured: tour.number === '02' }]}>
            <div class="card-top"><span>{tour.number}</span></div>
            <h3><a href="/dolphin-tour-lovina/#boats">{tour.title}</a></h3><p class="price">{tour.price}</p><p class="card-note">{tour.note}</p>
            <ul>{tour.items.map((item) => <li><Check size={15}/>{item}</li>)}</ul>
            <a href={whatsappUrl}>Ask about this tour <ArrowRight size={14}/></a>
          </article>
        ))}
      </div>
    </section>

    <section class="private-section section">
      <div class="shell private-grid">
        <div class="private-image reveal"><img src="/images/lovina-sunrise.png" alt="A private traditional boat on the calm Lovina Sea" loading="lazy" /><span>A boat for your group.</span></div>
        <div class="private-copy reveal"><p class="kicker">Private boat</p><h2 class="title">A quieter way<br/>to go.</h2><p class="lede">A boat for your own group rather than a shared departure. Tell Ayu your group size and ask which package, schedule, and inclusions are available.</p>
          <div class="rate-list">{privateRates.map(([group, rate]) => <div><span>{group}</span><strong>{rate}</strong></div>)}</div>
          <a class="button" href="/dolphin-tour-lovina/#boats">Explore private boat options <ArrowRight size={14}/></a>
        </div>
      </div>
    </section>

    <section class="transport section" id="transport">
      <div class="shell section-heading reveal"><div><p class="kicker">On the road</p><h2 class="title">Private &amp; group transport.</h2></div><p class="lede">Private cars, Hiace, and Elf serving Lovina, Singaraja, Negara, Denpasar, and airport transfers. Long-term car and motorbike rentals are also available.</p></div>
      <div class="shell transport-grid">
        <article class="transport-card reveal"><BusFront size={24}/><h3>Private car</h3><p>Terios, Avanza, Xpander, or Xenia for solo travellers, couples, and families. A female driver may be requested, subject to availability.</p><a class="transport-link" href="/transportasi/sewa-mobil-singaraja/">Explore private car transport <ArrowRight size={14}/></a></article>
        <article class="transport-card reveal"><ShipWheel size={24}/><h3>HiAce or ELF</h3><p>Hiace seats up to 15 passengers plus a driver; Elf seats up to 19 plus a driver. For group outings, arisan, and tirta yatra.</p><a class="transport-link" href="/transportasi/rombongan/">Explore group transport <ArrowRight size={14}/></a></article>
        <article class="transport-card reveal"><Sparkles size={24}/><h3>Long-term rentals</h3><p>Car and motorbike rentals for longer stays. Contact Ayu for availability, rental terms, and pricing.</p><a class="transport-link" href="/sewa-kendaraan-jangka-panjang/">Explore long-term car &amp; motorbike rental <ArrowRight size={14}/></a></article>
      </div>
      <div class="shell route-table reveal"><div class="table-title"><span class="kicker">Popular routes</span><span>Pricing</span></div>{routes.map(([route, price]) => <div class="route-row"><span>{route}</span><strong>{price}</strong></div>)}<p>Share your pickup point, destination, date, and group size for a transport quote.</p><a class="transport-link" href="/transportasi/">Explore Lovina &amp; Singaraja transport <ArrowRight size={14}/></a></div>
    </section>

    <section class="section local-trips" id="local-trips">
      <div class="shell section-heading"><div><p class="kicker">Beyond the sea</p><h2 class="title">Plan a day in<br/>North Bali.</h2></div><p class="lede">Ask Bu Ayu about local routes, transport, and hotel or villa recommendations. Choose your stops together before confirming an itinerary.</p></div>
      <div class="shell destination-grid">
        <article class="destination-card"><div class="destination-image"><img src="/images/family-transport.webp" alt="A family vehicle for exploring North Bali" loading="lazy"/><span class="destination-tag">01 / Culture &amp; local life</span></div><div class="destination-copy"><h3>Singaraja</h3><p>Local markets, Sasana Budaya, Chinese Temple, and Beji Temple. Plan the stops and pace with Ayu.</p><a href="/tur-bali-utara/#singaraja">Plan a Singaraja tour <span class="card-arrow"><ArrowRight size={17}/></span></a></div></article>
        <article class="destination-card"><div class="destination-image"><img src="/images/hidden-waterfall.png" alt="Waterfall scenery as inspiration for a North Bali day trip" loading="lazy"/><span class="destination-tag">02 / Springs &amp; waterfalls</span></div><div class="destination-copy"><h3>Banjar &amp; waterfalls</h3><p>Ask about Banjar Hot Spring, Buddhist Temple, or a visit to Sekumpul. Choose a route that fits your day.</p><a href="/tur-bali-utara/#banjar">Explore Banjar &amp; tour options <span class="card-arrow"><ArrowRight size={17}/></span></a></div></article>
        <article class="destination-card"><div class="destination-image"><img src="/images/lovina-sunrise.png" alt="A quiet morning in North Bali before an inland day trip" loading="lazy"/><span class="destination-tag">03 / An inland escape</span></div><div class="destination-copy"><h3>Aling-Aling &amp; beyond</h3><p>Discuss Aling-Aling and an onward route through Munduk toward Ulun Danu Bratan. Confirm timing with Ayu.</p><a href="/tur-bali-utara/#aling-aling-munduk">Discuss the inland tour route <span class="card-arrow"><ArrowRight size={17}/></span></a></div></article>
      </div>
      <p class="shell destination-note">A little inspiration for your route. Images are illustrative; stops and itinerary are agreed with Ayu.</p>
    </section>

    <section class="about section" id="about">
      <div class="shell about-grid">
        <div class="about-image reveal"><img src="/images/buk-ayu.jpeg" alt="Bu Ayu, owner of Utami Mesari Tours" width="908" height="1600" loading="lazy" style="object-position:center 30%" /></div>
        <div class="about-copy reveal"><p class="kicker">Your local contact</p><h2 class="title">Bu Ayu.</h2><p class="about-lead">From an insurance career in 2010 to local tours and transport.</p><p class="lede">Through her work in insurance, Ayu built relationships with business clients, hotels, villas, and dolphin tour operators. Today she helps couples, families, groups, and solo travellers plan their time in Lovina, with support in Indonesian and English.</p>
          <div class="about-points"><span><Check size={15}/> Local itinerary help</span><span><Check size={15}/> Hotel & villa recommendations</span><span><Check size={15}/> Indonesian & English spoken</span></div>
          <a class="button" href={whatsappUrl}>Talk to Ayu <ArrowRight size={14}/></a>
        </div>
      </div>
    </section>

    <section class="gallery-preview section" id="gallery-preview">
      <div class="shell gallery-heading reveal">
        <div><p class="kicker">From the gallery</p><h2 class="title">A glimpse of<br/>the journey.</h2></div>
        <div><p class="lede">Mornings on the sea, family-sized rides, and more room when everyone is coming along.</p><a href="/gallery">View the full gallery <ArrowRight size={14}/></a></div>
      </div>
      <div class="shell gallery-teasers">
        <a class="gallery-teaser dolphin reveal" href="/gallery#dolphins"><img src="/images/dolphin-journey.png" alt="Dolphin tour on the Lovina Sea" loading="lazy"/><span><small>01 · At sea</small>Dolphin tour <ArrowRight size={15}/></span></a>
        <a class="gallery-teaser reveal" href="/gallery#family-transport"><img src="/images/family-transport.webp" alt="White family transport in North Bali" loading="lazy"/><span><small>02 · On the road</small>Family transport <ArrowRight size={15}/></span></a>
        <a class="gallery-teaser reveal" href="/gallery#group-transport"><img src="/images/group-transport.webp" alt="Group transport vehicles in North Bali" loading="lazy"/><span><small>03 · More room</small>Group transport <ArrowRight size={15}/></span></a>
      </div>
    </section>

    <section class="reviews section" id="reviews">
      <div class="shell section-heading"><div><p class="kicker">Booking with Bu Ayu</p><h2 class="title">From first message<br/>to meeting point.</h2></div><p class="lede">Your main contact at Utami Mesari Tours is Bu Ayu. Ask about availability and agree on the package, price, and terms before making payment.</p></div>
      <ol class="shell booking-steps">
        <li><h3>Share your plans</h3><p>Send your travel date, group size, pickup location, and the tour or vehicle you need.</p></li>
        <li><h3>Confirm your booking</h3><p>Agree on inclusions, any pickup charge, payment arrangements, and cancellation or weather terms with Ayu.</p></li>
        <li><h3>Receive your trip details</h3><p>After payment, receive your captain, meeting point, and rundown, or confirm your hotel pickup as agreed.</p></li>
      </ol>
      <div class="shell map-wrap">
        <div class="map-frame" data-map>
          <div class="map-preview"><div class="map-topography" aria-hidden="true"><span class="map-coast"></span><span class="map-road road-one"></span><span class="map-road road-two"></span></div><span class="map-sea-label">BALI SEA</span><div class="map-pin"><MapPin size={25}/><strong>Lovina</strong><small>North Bali</small></div><button class="map-load" type="button"><MapPin size={16}/> Explore the interactive map <ArrowRight size={16}/></button><span class="map-preview-note">Area illustration · Not to scale</span></div>
          <iframe title="Interactive map of Lovina Beach, North Bali" data-map-src="https://maps.google.com/maps?q=Lovina%20Beach%20Bali&amp;t=m&amp;z=12&amp;output=embed" referrerpolicy="no-referrer-when-downgrade" allowfullscreen hidden></iframe>
          <a class="map-external" href="https://maps.google.com/?q=Lovina+Beach+Bali" target="_blank" rel="noreferrer">Open Google Maps <ArrowRight size={14}/></a>
        </div>
        <div class="map-copy"><p class="kicker">Meet us in the north</p><h3>A morning<br/>in Lovina.</h3><p>Our travel area is Lovina Beach, North Bali. Your exact meeting point and captain are shared after payment.</p><div class="map-detail"><MapPin size={18}/><span>Hotel pickup available<br/><small>Extra charge based on location</small></span></div><a class="button secondary" href={whatsappUrl}>Arrange your pickup <ArrowRight size={14}/></a><small class="map-disclaimer">Area guide, not an office address.</small></div>
      </div>
    </section>

    <section class="section planning-help" id="planning-help">
      <div class="shell section-heading"><div><p class="kicker">Before you book</p><h2 class="title">A few useful answers.</h2></div><p class="lede">Start with these details, then ask Ayu about your specific date and group.</p></div>
      <div class="shell faq-layout">
        <aside class="faq-aside"><span class="faq-eyebrow">A little clarity<br/> before you go.</span><p>Every trip starts with a conversation. Bu Ayu can help you work out the details.</p><a href={whatsappUrl}>Ask Ayu directly <ArrowRight size={16}/></a><span class="faq-language">Indonesian &amp; English</span></aside>
        <div class="home-faq">
          <details open><summary><span class="faq-number">01</span><span>How much does a dolphin tour or transfer cost?</span><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>Ask Ayu for a quote for your date, group size, boat or vehicle, and pickup location. Confirm what is included and any extra charges before booking.</p></div></details>
          <details><summary><span class="faq-number">02</span><span>When does the dolphin tour leave?</span><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>Departure is usually around 06:00, with a return around 08:00–09:00 depending on the package. Confirm your exact meeting time when booking.</p></div></details>
          <details><summary><span class="faq-number">03</span><span>Can you help families and groups with transport?</span><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>Yes. Options include family cars, Hiace for up to 15 passengers plus a driver, and Elf for up to 19 passengers plus a driver. Confirm the vehicle and luggage needs with Ayu.</p></div></details>
          <details><summary><span class="faq-number">04</span><span>Can I arrange a longer stay or a local itinerary?</span><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>Ask about long-term car and motorbike rentals, hotel or villa recommendations, and local trip planning. Availability, rental terms, and prices are confirmed directly with Ayu.</p></div></details>
        </div>
      </div>
      <div class="shell journal-intro"><div><p class="kicker">A few notes from the north</p><h3>A little reading.<br/>A better trip.</h3></div><a href="/blog">Explore the journal <ArrowRight size={16}/></a></div>
      <div class="shell journal-grid">{posts.map((post, index) => <a class="journal-card" href={`/blog/${post.slug}`}><div class="journal-image"><img src={post.image} alt={post.alt} loading="lazy"/><span class="journal-index">0{index + 1}</span><span class="journal-arrow"><ArrowRight size={21}/></span></div><div class="journal-copy"><span class="journal-category">{post.category}</span><h4>{post.title}</h4><p>{post.excerpt}</p><span class="journal-read">Read the story <ArrowRight size={14}/></span></div></a>)}</div>
    </section>

    <section class="contact section" id="contact"><div class="shell contact-inner reveal"><p class="kicker">Start here</p><h2>Tell us when you’re coming.</h2><p>Send your date, number of guests, pickup location, and the experience you want. We’ll help with the rest.</p><a class="button contact-button" href={whatsappUrl}>Chat with Bu Ayu <ArrowRight size={15}/></a><p class="contact-details"><a href={whatsappUrl}>{business.phone}</a><br/>Indonesian &amp; English · <a href={business.instagramUrl} target="_blank" rel="noreferrer">{business.instagramHandle}</a></p></div></section>
  </main>

  <SiteFooter />

  <p class="page-updated shell">Last updated: <time datetime={updatedAt}>25 October 2026</time></p>

  <script>
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    document.querySelectorAll<HTMLDetailsElement>('.home-faq details').forEach((details) => {
      const summary = details.querySelector('summary')!;
      const answer = details.querySelector<HTMLElement>('.faq-answer')!;
      let animation: Animation | undefined;
      let expanded = details.open;
      summary.setAttribute('aria-expanded', String(expanded));
      summary.addEventListener('click', (event) => {
        event.preventDefault();
        const from = details.getBoundingClientRect().height;
        animation?.cancel();
        expanded = !expanded;
        summary.setAttribute('aria-expanded', String(expanded));
        details.classList.toggle('is-closing', !expanded);
        details.open = true;
        const summaryHeight = summary.getBoundingClientRect().height;
        const to = expanded ? summaryHeight + answer.getBoundingClientRect().height : summaryHeight;
        if (reduceMotion.matches) { details.open = expanded; details.classList.remove('is-closing'); return; }
        animation = details.animate([{ height: `${from}px` }, { height: `${to}px` }], { duration: 360, easing: 'cubic-bezier(.22,1,.36,1)' });
        animation.onfinish = () => { details.open = expanded; details.classList.remove('is-closing'); animation = undefined; };
      });
    });
    const map = document.querySelector<HTMLElement>('[data-map]');
    const mapButton = map?.querySelector<HTMLButtonElement>('.map-load');
    mapButton?.addEventListener('click', () => {
      const frame = map?.querySelector<HTMLIFrameElement>('iframe');
      if (!frame || !mapButton) return;
      frame.src = frame.dataset.mapSrc ?? '';
      frame.hidden = false;
      map?.classList.add('map-requested');
      frame.focus();
    });
    const header = document.querySelector<HTMLElement>('[data-header]');
    const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
    const syncHeader = () => header?.classList.toggle('scrolled', window.scrollY > 48);
    syncHeader();
    window.addEventListener('scroll', syncHeader, { passive: true });
    const closeMenu = () => { header?.classList.remove('open'); menuButton?.setAttribute('aria-expanded','false'); document.body.classList.remove('menu-open'); };
    menuButton?.addEventListener('click', () => { const open = !header?.classList.contains('open'); header?.classList.toggle('open', open); menuButton.setAttribute('aria-expanded', String(open)); document.body.classList.toggle('menu-open', open); });
    document.querySelectorAll('.mobile-nav a').forEach((link) => link.addEventListener('click', closeMenu));
  </script>
</BaseLayout>

<style>
  .transport-link{display:inline-flex;align-items:center;gap:.5rem;margin-top:1.2rem;font-size:.75rem;text-decoration:underline;text-underline-offset:4px}
  .hero-copy h1.brand-heading{font-size:clamp(3.5rem,9vw,8rem);line-height:.94;letter-spacing:-.06em;overflow-wrap:normal}.brand-heading span{display:block;font-size:.56em;letter-spacing:-.035em;margin-top:.2em}.local-trips{background:var(--white)}.booking-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;list-style:decimal-leading-zero;padding-left:2rem}.booking-steps li{padding-left:.5rem}.booking-steps h3,.reading-links h3{font-size:1.1rem}.booking-steps p,.home-faq p{font-size:.9rem;line-height:1.75;color:var(--muted)}.home-faq details{padding:1.2rem 0;border-bottom:1px solid var(--line)}.home-faq summary{cursor:pointer;font-weight:500;line-height:1.6}.home-faq p{max-width:75ch}.reading-links{margin-top:3rem;display:grid;gap:1rem}.reading-links a{display:flex;align-items:center;gap:.7rem;text-decoration:underline;text-underline-offset:4px;font-size:.9rem}.page-updated{font-size:.75rem;color:var(--muted);padding-bottom:1.5rem}.booking-steps li::marker{color:var(--sea);font-weight:600}
  @media(max-width:850px){.booking-steps{grid-template-columns:1fr;gap:1rem}.hero-copy h1.brand-heading{font-size:clamp(3.2rem,10vw,5.5rem)}}

  .header{position:fixed;inset:0 0 auto;z-index:50;color:var(--white);background:transparent;border-bottom:1px solid rgba(255,255,255,.25);transition:background .3s ease,color .3s ease,border-color .3s ease,box-shadow .3s ease;backdrop-filter:blur(0)}.nav{height:76px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center}.brand{display:flex;align-items:center;gap:.7rem;width:max-content;font-size:.86rem;font-weight:600;letter-spacing:-.02em}.brand-mark{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--white);color:var(--ink);transition:.3s ease}.brand small{display:block;color:rgba(255,255,255,.72);font-size:.58rem;font-weight:500;letter-spacing:.13em;text-transform:uppercase;margin-top:.1rem;transition:color .3s ease}.nav-links{display:flex;gap:2rem;font-size:.76rem;color:rgba(255,255,255,.85)}.nav-links a:hover{color:var(--white)}.nav-cta{justify-self:end;min-height:40px;padding:.5rem 1rem;background:var(--white);border-color:var(--white);color:var(--ink)}.nav-cta:hover{background:transparent;color:var(--white)}.menu-button,.mobile-nav{display:none}.header.scrolled{color:var(--ink);background:rgba(246,247,243,.94);border-color:var(--line);box-shadow:0 8px 30px rgba(21,56,59,.06);backdrop-filter:blur(14px)}.header.scrolled .brand-mark{background:var(--ink);color:var(--white)}.header.scrolled .brand small,.header.scrolled .nav-links{color:var(--muted)}.header.scrolled .nav-links a:hover{color:var(--ink)}.header.scrolled .nav-cta{background:var(--ink);border-color:var(--ink);color:var(--white)}.header.scrolled .nav-cta:hover{background:var(--sea);border-color:var(--sea);color:var(--white)}
