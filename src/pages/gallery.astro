---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowRight, Maximize2, X } from 'lucide-astro';

const collections = [
  {
    id: 'dolphins',
    number: '01',
    eyebrow: 'At sea',
    title: 'Dolphin tour',
    description: 'Early light, calm northern water, and the small moments between leaving shore and finding the pod.',
    note: 'Dolphin watching · Snorkeling · Marine park',
    images: [
      { src: '/images/lovina-dolphins-hero.webp', alt: 'Dolphins surfacing beside a traditional boat at sunrise in Lovina', caption: 'First light on the Lovina Sea', className: 'landscape' },
      { src: '/images/dolphin-journey.png', alt: 'A quiet dolphin journey on the water in North Bali', caption: 'Out on the water', className: 'portrait' },
      { src: '/images/lovina-sunrise.png', alt: 'Traditional boat crossing the calm sea at sunrise', caption: 'The morning begins', className: 'square' },
    ],
  },
  {
    id: 'family-transport',
    number: '02',
    eyebrow: 'On the road',
    title: 'Family transport',
    description: 'Simple, comfortable vehicles for couples, families, airport transfers, and slower days around North Bali.',
    note: 'Private car · Airport transfer · Day trips',
    images: [
      { src: '/images/family-transport.webp', alt: 'White family minivan parked near the coast in North Bali', caption: 'Comfortable for the everyday route', className: 'landscape' },
      { src: '/images/family-transport-pickup.webp', alt: 'White passenger van ready for a family pickup in Bali', caption: 'Room for people and luggage', className: 'portrait' },
    ],
  },
  {
    id: 'group-transport',
    number: '03',
    eyebrow: 'More room',
    title: 'Group transport',
    description: 'HiAce and ELF-size transport for larger groups, with practical space for everyone and their luggage.',
    note: 'HiAce · ELF · Group transfers',
    images: [
      { src: '/images/group-transport.webp', alt: 'Two medium-size group transport buses in a tropical North Bali setting', caption: 'Built for travelling together', className: 'landscape' },
      { src: '/images/group-transport-red.webp', alt: 'Red medium-size tour bus ready for a group departure in North Bali', caption: 'A little more room for the road', className: 'portrait' },
    ],
  },
];
---

<BaseLayout title="Gallery — Lovina Travel" description="Dolphin tours and local transport, seen through the quieter moments around Lovina and North Bali.">
  <header class="gallery-nav shell">
    <a class="brand" href="/"><span>L</span><strong>Lovina Travel<small>North Bali</small></strong></a>
    <nav aria-label="Gallery navigation"><a href="/blog">Journal</a><a class="back" href="/"><ArrowLeft size={14}/> Home</a></nav>
  </header>

  <main>
    <section class="gallery-head shell">
      <p class="kicker">The gallery</p>
      <div class="head-grid">
        <h1>Seen along<br/>the way.</h1>
        <p>A closer look at mornings on the water and the vehicles that keep the rest of the journey easy.</p>
      </div>
    </section>

    <figure class="cover shell">
      <img src="/images/lovina-dolphins-hero.webp" alt="Dolphins swimming beside a traditional boat at sunrise in Lovina" />
      <figcaption><span>Lovina Sea</span><span>08°09' S · 115°01' E</span></figcaption>
    </figure>

    <nav class="collection-nav" aria-label="Gallery collections">
      <div class="shell">
        {collections.map((collection) => <a href={`#${collection.id}`}><span>{collection.number}</span>{collection.title}</a>)}
      </div>
    </nav>

    {collections.map((collection, collectionIndex) => (
      <section class:list={['collection section', { muted: collectionIndex === 1 }]} id={collection.id}>
        <div class="shell collection-heading reveal">
          <div><p class="kicker">{collection.eyebrow} · {collection.number}</p><h2>{collection.title}</h2></div>
          <div><p>{collection.description}</p><span>{collection.note}</span></div>
        </div>
        <div class:list={['shell photo-grid', `count-${collection.images.length}`]}>
          {collection.images.map((photo, photoIndex) => (
            <figure class:list={['photo reveal', photo.className]}>
              <button type="button" class="photo-button" data-lightbox-src={photo.src} data-lightbox-alt={photo.alt} data-lightbox-caption={photo.caption} aria-label={`Open photo: ${photo.caption}`}>
                <img src={photo.src} alt={photo.alt} loading={collectionIndex === 0 && photoIndex === 0 ? 'eager' : 'lazy'} />
                <span class="expand"><Maximize2 size={15}/></span>
              </button>
              <figcaption><span>{String(photoIndex + 1).padStart(2, '0')}</span>{photo.caption}</figcaption>
            </figure>
          ))}
        </div>
        {collectionIndex > 0 && <p class="shell vehicle-note">Vehicle photos show the transport category. The exact vehicle is confirmed with your booking.</p>}
      </section>
    ))}

    <section class="gallery-cta">
      <div class="shell reveal"><p class="kicker">Planning something?</p><h2>See it for yourself.</h2><a class="button" href="/#contact">Plan your Lovina trip <ArrowRight size={14}/></a></div>
    </section>
  </main>

  <footer><div class="shell"><span>© 2026 Lovina Travel</span><a href="/blog">Read the journal <ArrowRight size={14}/></a></div></footer>

  <dialog class="lightbox" aria-label="Expanded gallery photo">
    <button class="lightbox-close" type="button" aria-label="Close image"><X size={20}/></button>
    <img src="" alt="" />
    <p></p>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const dialogImage = dialog?.querySelector<HTMLImageElement>('img');
    const dialogCaption = dialog?.querySelector<HTMLParagraphElement>('p');
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog || !dialogImage || !dialogCaption) return;
        dialogImage.src = button.dataset.lightboxSrc ?? '';
        dialogImage.alt = button.dataset.lightboxAlt ?? '';
        dialogCaption.textContent = button.dataset.lightboxCaption ?? '';
        dialog.showModal();
      });
    });
    dialog?.querySelector<HTMLButtonElement>('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>

<style>
  :global(html),:global(body){width:100%;max-width:100vw;overflow-x:hidden}
  .gallery-nav{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:.65rem}.brand>span{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--white);font-weight:600}.brand strong{font-size:.82rem}.brand small{display:block;color:var(--muted);font-size:.55rem;letter-spacing:.12em;text-transform:uppercase}.gallery-nav nav{display:flex;align-items:center;gap:1.5rem;font-size:.72rem;font-weight:500}.back{display:flex;align-items:center;gap:.45rem}
  .gallery-head{padding-block:clamp(5rem,9vw,8.5rem) clamp(3rem,6vw,5rem)}.head-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:4rem;align-items:end}.head-grid>*{min-width:0}.gallery-head h1{font-size:clamp(5rem,11vw,10rem);font-weight:400;line-height:.8;letter-spacing:-.08em;margin:1.5rem 0 0}.head-grid>p{width:100%;max-width:38ch;margin:0;color:var(--muted);font-size:1rem;line-height:1.75}
  .cover{height:min(76svh,760px);position:relative;overflow:hidden;border-radius:1rem}.cover img{height:100%;object-fit:cover;object-position:center 54%}.cover:after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(7,29,31,.48))}.cover figcaption{position:absolute;z-index:1;inset:auto 1.25rem 1.15rem;display:flex;justify-content:space-between;color:var(--white);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase}
  .collection-nav{position:sticky;top:0;z-index:40;margin-top:2rem;background:rgba(246,247,243,.9);border-block:1px solid var(--line);backdrop-filter:blur(14px)}.collection-nav>div{height:68px;display:flex;align-items:center;gap:clamp(1.2rem,4vw,3.5rem)}.collection-nav a{display:flex;align-items:center;gap:.55rem;font-size:.72rem;white-space:nowrap}.collection-nav a span{color:var(--sea);font-size:.58rem}
  .collection{scroll-margin-top:68px}.collection.muted{background:var(--mist)}.collection-heading{display:grid;grid-template-columns:1.2fr .8fr;gap:4rem;align-items:end;margin-bottom:3rem}.collection-heading .kicker{margin-bottom:1rem}.collection-heading h2{font-size:clamp(3.5rem,7vw,7rem);font-weight:400;line-height:.88;letter-spacing:-.065em;margin:0}.collection-heading>div:last-child>p{max-width:43ch;margin:0;color:var(--muted);line-height:1.7}.collection-heading>div:last-child>span{display:block;margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--line);color:var(--sea);font-size:.65rem;letter-spacing:.08em;text-transform:uppercase}
  .photo-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:1rem;align-items:start}.photo{margin:0}.photo.landscape:first-child{grid-row:span 2}.photo-button{width:100%;height:100%;padding:0;position:relative;display:block;overflow:hidden;border:0;border-radius:.8rem;background:var(--line);cursor:zoom-in}.photo.landscape:first-child .photo-button{height:680px}.photo.portrait .photo-button,.photo.square .photo-button{height:332px}.photo img{height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.16,1,.3,1)}.photo-button:hover img{transform:scale(1.025)}.expand{position:absolute;right:1rem;top:1rem;width:36px;height:36px;display:grid;place-items:center;border-radius:50%;background:rgba(246,247,243,.92);color:var(--ink);opacity:0;transform:translateY(5px);transition:.3s ease}.photo-button:hover .expand{opacity:1;transform:none}.photo figcaption{display:flex;gap:.8rem;padding:.8rem .15rem 0;color:var(--muted);font-size:.67rem}.photo figcaption span{color:var(--sea)}.count-2 .photo.landscape:first-child{grid-row:auto}.count-2 .photo-button{height:520px}.vehicle-note{margin-top:2rem;color:var(--muted);font-size:.65rem}
  .gallery-cta{padding-block:clamp(6rem,10vw,10rem);background:var(--ink);color:var(--white);text-align:center}.gallery-cta .kicker{color:#b5d0ce}.gallery-cta h2{font-size:clamp(4rem,9vw,8rem);font-weight:400;line-height:.9;letter-spacing:-.07em;margin:1.2rem 0 2.2rem}.gallery-cta .button{background:var(--white);border-color:var(--white);color:var(--ink)}.gallery-cta .button:hover{background:var(--sea);border-color:var(--sea);color:var(--white)}footer{padding:2rem 0;background:var(--white)}footer>div{display:flex;justify-content:space-between;font-size:.68rem;color:var(--muted)}footer a{display:flex;align-items:center;gap:.5rem;color:var(--ink)}
  .lightbox{width:min(1120px,calc(100% - 2rem));max-height:calc(100svh - 2rem);padding:0;border:0;border-radius:1rem;background:var(--ink);color:var(--white);overflow:hidden}.lightbox::backdrop{background:rgba(7,24,26,.82);backdrop-filter:blur(8px)}.lightbox img{width:100%;max-height:calc(100svh - 7rem);object-fit:contain}.lightbox p{margin:.9rem 1.2rem 1.1rem;font-size:.7rem}.lightbox-close{position:absolute;z-index:2;right:.8rem;top:.8rem;width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:50%;background:rgba(246,247,243,.95);color:var(--ink);cursor:pointer}
  @media(max-width:760px){.gallery-nav{min-width:0}.gallery-nav nav{flex:0 0 auto;margin-left:1rem}.gallery-nav nav>a:first-child{display:none}.head-grid,.collection-heading{grid-template-columns:minmax(0,1fr);gap:1.7rem}.gallery-head h1{font-size:clamp(4.55rem,22vw,6.5rem)}.head-grid>p{max-width:100%;overflow-wrap:anywhere}.cover{width:calc(100% - 2rem);height:62svh}.collection-nav{max-width:100vw;overflow:hidden}.collection-nav>div{width:100%;min-width:0;max-width:none;padding-right:1rem;overflow-x:auto}.photo-grid{grid-template-columns:1fr}.photo.landscape:first-child,.photo.portrait .photo-button,.photo.square .photo-button,.count-2 .photo-button{height:58svh;max-height:520px}.photo.landscape:first-child{grid-row:auto}.photo figcaption{margin-bottom:1rem}.expand{opacity:1;transform:none}.gallery-cta h2{font-size:4.5rem}}
</style>
