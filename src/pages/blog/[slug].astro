---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/blog-layout.css';
import { ArrowLeft, ArrowRight, Clock3 } from 'lucide-astro';
import { posts, type Post } from '../../data/posts';
import { dolphinGuides } from '../../data/dolphin-guides';

export function getStaticPaths() { return posts.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
interface Props { post: Post }
const { post } = Astro.props;
const guide = dolphinGuides[post.slug];
const displayHeading = guide?.displayHeading ?? post.title;
const subtitle = guide?.subtitle;
const recommendedPosts = posts.filter(item => item.slug !== post.slug)
  .sort((a, b) => Number(b.slug === guide?.relatedSlug) - Number(a.slug === guide?.relatedSlug));
const articleData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  image: new URL(post.image, Astro.site).href,
  mainEntityOfPage: new URL(`/blog/${post.slug}`, Astro.site).href,
  publisher: { '@id': new URL('/#business', Astro.site).href },
  inLanguage: 'en',
  ...(guide ? { dateModified: guide.updated } : {}),
};
---
<BaseLayout title={`${post.title} — Utami Mesari Tours`} description={post.excerpt} image={post.image} imageAlt={post.alt} article>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleData).replace(/</g, '\\u003c')} />
  <header class="article-nav shell"><a href="/blog"><ArrowLeft size={14}/> Journal</a><a class="brand" href="/">Utami Mesari</a><a href="/dolphin-tour-lovina/">Dolphin tours <ArrowRight size={14}/></a></header>
  <main>
    <article>
      <header class:list={['article-head shell', { 'long-heading': displayHeading.length > 45 }]}><p class="kicker">{post.category}</p><h1>{displayHeading}</h1>{subtitle && <p class="article-subtitle">{subtitle}</p>}<div><span>{post.date}</span><span><Clock3 size={13}/>{post.readTime}</span></div>{guide && <p class="article-updated">Last updated: <time datetime={guide.updated}>1 November 2026</time> · By Utami Mesari Tours</p>}</header>
      <div class="hero-image shell"><img src={post.image} alt={post.alt}/></div>
      <div class="article-layout shell">
      <div class="article-body">
        {guide ? <>
          <div class="quick-answer"><p class="kicker">The short answer</p><p>{guide.answer}</p></div>
          <nav class="article-contents" aria-label="On this page"><h2>On this page</h2><ol>{guide.sections.map(section=><li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>
          {guide.sections.map(section=><section class="guide-section" id={section.id}><h2>{section.title}</h2><div set:html={section.html}/></section>)}
          <section class="guide-sources"><h2>Sources &amp; service information</h2><p>Tour arrangements here describe Utami Mesari Tours. Bu Ayu is the owner and booking contact; this article is not presented as her personal trip review. Package details are confirmed directly before payment. External sources below provide general context, not our prices or inclusions.</p><ul>{guide.sources.map(source=><li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a><p>{source.note}</p></li>)}</ul><p>External sources checked: 1 November 2026. <a href="/dolphin-tour-lovina/#what-you-get">See our tour arrangements and optional extras</a>.</p></section>
          <section class="related-guide"><p class="kicker">Continue planning</p><h2><a href={`/blog/${guide.relatedSlug}`}>{guide.relatedTitle} <ArrowRight size={18}/></a></h2></section>
        </> : post.body.map((paragraph) => <p>{paragraph}</p>)}
        <aside><p>Ready to discuss your date and boat?</p><a href="/dolphin-tour-lovina/">Explore our Lovina dolphin tour <ArrowRight size={14}/></a></aside>
      </div>
      <aside class="article-sidebar" aria-label="Recommended articles">
        <div class="sidebar-sticky">
          <p class="kicker">Keep exploring</p><h2>Recommended<br/>reading.</h2>
          <div class="sidebar-articles">{recommendedPosts.map(item => <a class="sidebar-card" href={`/blog/${item.slug}`}><img src={item.image} alt="" loading="lazy"/><div><span>{item.category}</span><h3>{dolphinGuides[item.slug]?.displayHeading ?? item.title}</h3><small>Read article <ArrowRight size={13}/></small></div></a>)}</div>
          <a class="sidebar-service" href="/dolphin-tour-lovina/"><span>Ready for the sea?</span><strong>Explore our dolphin tour <ArrowRight size={15}/></strong></a>
        </div>
      </aside>
      </div>
    </article>
  </main>
  <footer><a href="/blog"><ArrowLeft size={14}/> More stories from North Bali</a></footer>
</BaseLayout>
<style>
  .article-head .article-updated{font-size:.72rem;line-height:1.7;margin:1.2rem 0 0;color:var(--muted)}.quick-answer{padding:1.8rem;border-left:3px solid var(--sea);background:var(--mist);border-radius:0 .8rem .8rem 0}.quick-answer>p:last-child{font-size:1.03rem;line-height:1.85;margin:1rem 0 0}.article-contents{margin:2.5rem 0 3.5rem;border-block:1px solid var(--line);padding:1.5rem 0}.article-contents h2{font-size:1rem;font-weight:500;margin:0 0 1rem}.article-contents ol{margin:0;padding-left:1.3rem;display:grid;gap:.7rem}.article-contents a{font-size:.85rem;line-height:1.6;text-decoration:underline;text-underline-offset:4px}.guide-section{scroll-margin-top:2rem;margin:3rem 0}.guide-section h2{font-size:clamp(1.5rem,3vw,2rem);font-weight:500;line-height:1.22;letter-spacing:-.035em;margin:0 0 1.3rem}.guide-section :global(p),.guide-section :global(li){font-size:1rem;line-height:1.85;color:#3f5557}.guide-section :global(p){margin:0 0 1.2rem}.guide-section :global(li){margin:.6rem 0}.guide-section :global(a),.guide-sources a{text-decoration:underline;text-underline-offset:4px;color:var(--sea)}.guide-section :global(.comparison-scroll){overflow-x:auto;border:1px solid var(--line);border-radius:.8rem;margin:1.5rem 0}.guide-section :global(table){border-collapse:collapse;width:100%;min-width:480px;font-size:.83rem;line-height:1.7}.guide-section :global(caption){padding:1rem;text-align:left;font-size:.75rem;color:var(--muted);background:var(--mist)}.guide-section :global(th),.guide-section :global(td){padding:.9rem 1rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--line)}.guide-section :global(thead th){background:var(--ink);color:white;font-weight:500}.guide-section :global(tbody th){font-weight:500;width:30%;background:#edf2eb}.guide-sources{border-top:1px solid var(--line);padding-top:2rem;margin-top:3rem}.guide-sources h2{font-size:1.3rem;font-weight:500}.guide-sources p,.guide-sources li{font-size:.8rem;line-height:1.8;color:var(--muted)}.guide-sources ul{padding-left:1.1rem}.related-guide{margin:2.5rem 0;padding:1.7rem;background:white;border:1px solid var(--line);border-radius:1rem}.related-guide h2{font-size:1.3rem;line-height:1.4;font-weight:500;margin:1rem 0 0}.related-guide h2 a{display:flex;gap:1rem;align-items:center;justify-content:space-between}aside a{width:auto;max-width:100%}
  .article-nav{height:80px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line);font-size:.7rem}.article-nav>a{display:flex;align-items:center;gap:.45rem}.article-nav>a:last-child{justify-self:end}.brand{font-weight:600;font-size:.85rem}.article-head{max-width:980px;padding:clamp(5rem,10vw,9rem) 0 4rem;text-align:center}.article-head h1{font-size:clamp(3.5rem,8vw,7.8rem);font-weight:400;line-height:.92;letter-spacing:-.065em;margin:1.5rem auto 2rem}.article-head>div{display:flex;justify-content:center;gap:1.5rem;color:var(--muted);font-size:.68rem}.article-head>div span{display:flex;align-items:center;gap:.4rem}.hero-image{height:min(70vw,760px);border-radius:1rem;overflow:hidden}.hero-image img{height:100%;object-fit:cover}.article-body{width:min(100% - 2rem,680px);margin:5rem auto 8rem}.article-body>p{font-size:1.08rem;line-height:1.9;color:#3f5557;margin:0 0 1.8rem}.article-body>p:first-child::first-letter{float:left;font-size:4.8rem;line-height:.8;padding:.15rem .55rem 0 0;color:var(--ink)}aside{margin-top:4rem;padding:2rem;border-radius:1rem;background:var(--mist)}aside p{font-size:1.4rem;margin:0 0 1rem}aside a{display:flex;align-items:center;gap:.5rem;font-size:.72rem;font-weight:600;width:max-content}footer{padding:2rem;background:var(--ink);color:var(--white);display:flex;justify-content:center}footer a{display:flex;align-items:center;gap:.5rem;font-size:.7rem}
  @media(max-width:620px){.article-nav{grid-template-columns:1fr auto}.article-nav .brand{display:none}.article-head{padding:4.5rem 1rem 3rem}.article-head h1{font-size:3.7rem}.hero-image{width:calc(100% - 2rem);height:58svh}.article-body{margin:3.5rem auto 5rem}}
  .article-head{padding-block:clamp(3.5rem,7vw,6rem) 3rem}
  .article-head h1{font-size:clamp(2.5rem,5.4vw,4.6rem);line-height:1.12;letter-spacing:-.045em;max-width:22ch;margin:1.3rem auto 1.5rem;text-wrap:balance;overflow-wrap:normal;hyphens:none}
  .article-head .article-subtitle{font-size:clamp(1.05rem,2vw,1.4rem);line-height:1.6;letter-spacing:-.015em;color:var(--muted);max-width:42ch;margin:0 auto 1.8rem;text-wrap:balance}
  @media(max-width:620px){.article-head{padding:3rem 0 2.5rem}.article-head h1{font-size:clamp(2rem,8.5vw,3rem);line-height:1.15;letter-spacing:-.035em;max-width:19ch}.article-head .article-subtitle{font-size:1.05rem;max-width:29ch;margin-bottom:1.5rem}.article-head>div{flex-wrap:wrap;gap:.6rem 1.2rem}}
  .article-head h1{font-size:clamp(3rem,6.6vw,5.8rem);line-height:1.08;max-width:20ch}
  .article-head.long-heading h1{font-size:clamp(2.7rem,5.8vw,5rem);max-width:24ch}
  .article-head .article-subtitle{font-size:clamp(1.5rem,3vw,2.3rem);line-height:1.35;color:var(--ink);max-width:30ch;margin:.2rem auto 2.2rem;letter-spacing:-.025em}
  @media(max-width:620px){.article-head h1{font-size:clamp(2.6rem,10vw,3.8rem);line-height:1.12}.article-head.long-heading h1{font-size:clamp(2.3rem,8.8vw,3.2rem)}.article-head .article-subtitle{font-size:clamp(1.4rem,5.5vw,1.9rem);line-height:1.4;margin:.4rem auto 1.8rem;max-width:24ch}}
</style>
