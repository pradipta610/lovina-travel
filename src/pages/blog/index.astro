---
import SiteFooter from '../../components/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ArrowRight, Clock3 } from 'lucide-astro';
import { posts } from '../../data/posts';
import { dolphinGuides } from '../../data/dolphin-guides';
const [featured, ...morePosts] = posts;
const featuredGuide = dolphinGuides[featured.slug];
---
<BaseLayout title="Journal — Utami Mesari" description="Simple notes for planning a slower trip through Lovina and North Bali.">
  <header class="blog-nav shell"><a class="brand" href="/"><span>U</span><strong>Utami Mesari<small>North Bali</small></strong></a><a class="back" href="/"><ArrowLeft size={14}/> Back to home</a></header>
  <main>
    <section class="journal-head shell"><p class="kicker">The journal</p><h1>Notes from<br/>North Bali.</h1><p>Practical guides, quiet places, and a little context for travelling around Lovina.</p></section>
    <section class="featured shell">
      <a class="feature-image" href={`/blog/${featured.slug}`}><img src={featured.image} alt={featured.alt}/></a>
      <div class="feature-copy"><p class="meta">{featured.category} · {featured.date}</p><h2><a href={`/blog/${featured.slug}`}>{featuredGuide?.displayHeading ?? featured.title}</a></h2>{featuredGuide?.subtitle && <p class="feature-subtitle">{featuredGuide.subtitle}</p>}<p>{featured.excerpt}</p><a class="read" href={`/blog/${featured.slug}`}>Read story <ArrowRight size={14}/></a></div>
    </section>
    <section class="post-grid shell">
      {morePosts.map((post) => <article><a class="card-image" href={`/blog/${post.slug}`}><img src={post.image} alt={post.alt} loading="lazy"/></a><p class="meta">{post.category} · {post.date}</p><h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2><p>{post.excerpt}</p><span><Clock3 size={13}/>{post.readTime}</span></article>)}
    </section>
    <nav class="journal-services shell" aria-label="Plan with these guides"><p>Ready to turn your reading into a plan?</p><a href="/dolphin-tour-lovina/">Explore Lovina dolphin tours <ArrowRight size={14}/></a><a href="/transportasi/">Find Lovina &amp; Singaraja transport <ArrowRight size={14}/></a><a href="/tur-bali-utara/">Plan a North Bali tour <ArrowRight size={14}/></a></nav>
  </main>
  <SiteFooter />
</BaseLayout>
<style>
  .journal-services{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 2rem;padding-bottom:4rem}.journal-services p{width:100%;margin:0;color:var(--muted);font-size:.9rem}.journal-services a{display:inline-flex;align-items:center;gap:.5rem;font-size:.8rem;text-decoration:underline;text-underline-offset:4px;line-height:1.8}
  .blog-nav{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:.65rem}.brand>span{width:32px;height:32px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--white);font-weight:600}.brand strong{font-size:.82rem}.brand small{display:block;color:var(--muted);font-size:.55rem;letter-spacing:.12em;text-transform:uppercase}.back,.read{display:flex;align-items:center;gap:.5rem;font-size:.72rem;font-weight:500}.journal-head{padding:clamp(5rem,10vw,9rem) 0}.journal-head h1{font-size:clamp(4rem,10vw,9rem);font-weight:400;line-height:.82;letter-spacing:-.075em;margin:1.5rem 0 2rem}.journal-head>p:last-child{max-width:43ch;color:var(--muted);line-height:1.7}.featured{display:grid;grid-template-columns:1.35fr .65fr;gap:clamp(2rem,6vw,6rem);align-items:center;padding-bottom:7rem}.feature-image{height:600px;border-radius:1rem;overflow:hidden}.feature-image img,.card-image img{height:100%;object-fit:cover;transition:transform .7s ease}.feature-image:hover img,.card-image:hover img{transform:scale(1.025)}.meta{font-size:.64rem!important;letter-spacing:.1em;text-transform:uppercase;color:var(--sea)!important}.feature-copy h2{font-size:clamp(2.4rem,5vw,4.8rem);font-weight:400;line-height:1;letter-spacing:-.055em;margin:1.2rem 0}.feature-copy>p:not(.meta),article>p:not(.meta){color:var(--muted);line-height:1.7;font-size:.86rem}.read{margin-top:2rem;width:max-content;border-bottom:1px solid;padding-bottom:.35rem}.post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;padding-bottom:8rem}.post-grid article{padding-bottom:2rem;border-bottom:1px solid var(--line)}.card-image{display:block;height:360px;border-radius:.8rem;overflow:hidden;margin-bottom:1.5rem}.post-grid h2{font-size:2rem;font-weight:400;letter-spacing:-.04em;margin:.8rem 0}.post-grid article>span{display:flex;align-items:center;gap:.4rem;margin-top:1.5rem;color:var(--muted);font-size:.68rem}footer{background:var(--ink);color:var(--white);padding:2rem 0}footer>div{display:flex;justify-content:space-between;font-size:.68rem}footer a{display:flex;align-items:center;gap:.5rem}
  @media(max-width:760px){.journal-head{padding:5rem 0}.journal-head h1{font-size:4.5rem}.featured{grid-template-columns:1fr;padding-bottom:5rem}.feature-image{height:58svh}.post-grid{grid-template-columns:1fr}.card-image{height:320px}.back{font-size:0}.back svg{width:19px;height:19px}}
  .featured{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(2rem,5vw,4.5rem);align-items:center}
  .feature-copy{min-width:0}
  .feature-copy h2{font-size:clamp(2.2rem,3.4vw,3.4rem);line-height:1.15;letter-spacing:-.04em;text-wrap:balance;margin:1.1rem 0}
  .feature-copy>p.feature-subtitle{font-size:clamp(1.15rem,1.8vw,1.55rem);line-height:1.4;letter-spacing:-.02em;color:var(--ink);text-wrap:balance;margin:0 0 1.4rem}
  .feature-image{height:clamp(400px,42vw,560px)}
  @media(max-width:760px){.featured{grid-template-columns:1fr;gap:2rem}.feature-image{height:380px}.feature-copy h2{font-size:clamp(2rem,7.5vw,3rem);max-width:22ch}.feature-copy>p.feature-subtitle{font-size:1.3rem}}
</style>
