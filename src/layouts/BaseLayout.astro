---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Lovina Travel — Dolphin Tours & Transport', description = 'Dolphin tours, snorkeling, private transport, and trusted local travel help in Lovina, North Bali.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import { inView } from 'motion';
      import Lenis from 'lenis';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;

      if (!reducedMotion && finePointer) {
        const lenis = new Lenis({
          duration: 1.05,
          smoothWheel: true,
          wheelMultiplier: 0.82,
          easing: (t) => 1 - Math.pow(1 - t, 4),
        });

        const frame = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);

        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const target = link.getAttribute('href');
            if (!target || target === '#') return;
            const element = document.querySelector<HTMLElement>(target);
            if (!element) return;
            event.preventDefault();
            lenis.scrollTo(element, { offset: -76, duration: 1 });
            history.replaceState(null, '', target);
          });
        });
      }

      document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => {
        inView(element, () => {
          element.classList.add('is-visible');
        }, { margin: '0px 0px -8% 0px' });
      });
    </script>
  </body>
</html>
