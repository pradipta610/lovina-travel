---
import '../styles/global.css';
import { business } from '../data/business';
import { ArrowUp, MessageCircle } from 'lucide-astro';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; article?: boolean; }
const { title = 'Utami Mesari — Dolphin Tours & Transport', description = 'Dolphin tours and private transport with Bu Ayu in Lovina, North Bali. Serving Singaraja, Negara, Denpasar, and airport transfers. Indonesian and English spoken.' } = Astro.props;
const { whatsappUrl } = business;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site);
const { image = '/images/lovina-dolphins-hero.webp', imageAlt = 'Dolphins at sunrise in Lovina, North Bali', article = false } = Astro.props;
const socialImage = new URL(image, site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'TravelAgency', '@id': new URL('/#business', site).href, name: 'Utami Mesari', url: site.href, telephone: business.phone, image: new URL('/images/lovina-dolphins-hero.webp', site).href, sameAs: [business.instagramUrl], areaServed: ['Lovina', 'Singaraja', 'Negara', 'Denpasar'], contactPoint: { '@type': 'ContactPoint', telephone: business.phone, contactType: 'reservations', availableLanguage: ['English', 'Indonesian'] } },
    { '@type': 'WebSite', '@id': new URL('/#website', site).href, url: site.href, name: 'Utami Mesari', inLanguage: 'en', publisher: { '@id': new URL('/#business', site).href } },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Utami Mesari" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <slot name="head" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&amp;display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <nav class="floating-dock" aria-label="Quick actions">
      <a class="floating-action whatsapp-action" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="Chat with Utami Mesari on WhatsApp" data-label="WhatsApp">
        <MessageCircle size={19} stroke-width={1.8} />
      </a>
      <button class="floating-action scroll-top-action" type="button" aria-label="Scroll to the top" data-label="Back to top">
        <ArrowUp size={19} stroke-width={1.8} />
      </button>
    </nav>
    <script>
      import { inView } from 'motion';
      import Lenis from 'lenis';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(pointer: fine)').matches;
      const scrollTopAction = document.querySelector<HTMLElement>('.scroll-top-action');
      let lenis: Lenis | undefined;
      const syncScrollTop = () => scrollTopAction?.classList.toggle('is-visible', window.scrollY > window.innerHeight * .7);
      syncScrollTop();
      window.addEventListener('scroll', syncScrollTop, { passive: true });

      if (!reducedMotion && finePointer) {
        const activeLenis = new Lenis({
          duration: 1.05,
          smoothWheel: true,
          wheelMultiplier: 0.82,
          easing: (t) => 1 - Math.pow(1 - t, 4),
        });
        lenis = activeLenis;

        const frame = (time: number) => {
          activeLenis.raf(time);
          requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);

        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const target = link.getAttribute('href');
            if (!target || target === '#') return;
            const element = document.querySelector<HTMLElement>(target);
            if (!element) return;
            event.preventDefault();
            activeLenis.scrollTo(element, { offset: -76, duration: 1 });
            history.replaceState(null, '', target);
          });
        });

        if (window.location.hash) {
          window.addEventListener('load', () => {
            const initialTarget = document.querySelector<HTMLElement>(window.location.hash);
            if (initialTarget) activeLenis.scrollTo(initialTarget, { offset: -76, immediate: true });
          }, { once: true });
        }
      }

      scrollTopAction?.addEventListener('click', () => {
        if (lenis) {
          lenis.scrollTo(0, { duration: 1 });
          return;
        }
        window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
      });

      document.querySelectorAll<HTMLElement>('.reveal').forEach((element) => {
        inView(element, () => {
          element.classList.add('is-visible');
        }, { margin: '0px 0px -8% 0px' });
      });
    </script>
  </body>
</html>
