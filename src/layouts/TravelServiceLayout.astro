---
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/transport-layout.css';
import serviceStyles from '../styles/travel-service.css?url';
import { ArrowRight, ArrowUpRight, Check, MessageCircle } from 'lucide-astro';
import { travelServices, serviceEnquiry } from '../data/travel-services';
interface Props { page: 'tours' | 'rentals' }
const { page } = Astro.props;
const content = travelServices[page];
const rental = page === 'rentals';
const updated = '2026-11-03';
const quote = serviceEnquiry(content.service, rental);
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: content.title, description: content.description, url: new URL(content.path, Astro.site).href, dateModified: updated, inLanguage: 'en', mainEntity: { '@type': 'Service', name: content.service, serviceType: content.service, provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: { '@type': 'Place', name: rental ? 'Lovina' : 'North Bali' } } };
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: rental ? 'Long-term rentals' : 'North Bali tour', item: new URL(content.path, Astro.site).href }] };
---
<BaseLayout title={content.title} description={content.description} image={content.image} imageAlt={content.imageAlt}>
  <Fragment slot="head"><link rel="stylesheet" href={serviceStyles}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\u003c')} /></Fragment>
  <header class="road-header"><div class="shell road-nav"><a class="brand" href="/"><span class="brand-mark">U</span><span>Utami Mesari Tours<small>Lovina · North Bali</small></span></a><nav aria-label="Travel services"><a href="/tur-bali-utara/" aria-current={!rental ? 'page' : undefined}>North Bali tours</a><a href="/sewa-kendaraan-jangka-panjang/" aria-current={rental ? 'page' : undefined}>Long-term rentals</a><a href="/transportasi/">Transport</a></nav><a class="button header-cta" href={quote}>Ask Bu Ayu <ArrowUpRight size={16}/></a></div></header>
  <main id="top" class="travel-service-page">
    <section class="shell road-hero"><div class="hero-copy"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>{rental ? 'Long-term rentals' : 'North Bali tour'}</span></nav><p class="kicker">{content.kicker}</p><h1>{content.heading}</h1><p class="hero-intro">{content.intro}</p><a class="button" href="#options">{rental ? 'Explore rental options' : 'Find your starting route'} <ArrowRight size={16}/></a><p class="hero-meta">Bu Ayu · Indonesian &amp; English spoken</p></div><figure class="hero-image"><img src={content.image} alt={content.imageAlt} fetchpriority="high"/><figcaption>{rental ? 'For a longer stay' : 'Beyond the sea'}</figcaption></figure></section>
    <p class="shell service-image-note">{content.imageNote}</p>
    <section class="answer-band"><div class="shell answer-inner"><p class="kicker">{content.service}</p><p>{content.answer}</p></div></section>
    <nav class="shell page-jumps" aria-label="On this page"><a href="#options">{rental ? 'Car & motorbike options' : 'Tour route options'}</a><a href={rental ? '#rental-period' : '#itinerary'}>{rental ? 'Rental period' : 'Your itinerary'}</a><a href="#costs">Price &amp; inclusions</a><a href="#booking">How to arrange it</a><a href="#questions">Questions</a></nav>
    <section class="section shell" id="options"><div class="section-heading"><div><p class="kicker">{rental ? 'Choose the type of vehicle' : 'North Bali tour options'}</p><h2 class="title">{content.optionsTitle}</h2></div><p class="lede">{content.optionsIntro}</p></div><div class:list={['service-options', { 'rental-options': rental }]}>{content.cards.map(card => <article id={card.id}><p class="kicker">{card.label}</p><h3>{card.title}</h3><p>{card.text}</p><ul>{card.points.map(point => <li><Check size={16}/><span>{point}</span></li>)}</ul><a class="text-link" href={serviceEnquiry(card.enquiry, rental)}>{card.cta} <ArrowUpRight size={15}/></a></article>)}</div></section>
    <div class="shell details-sections">{content.sections.map((section, index) => <section class="detail-section" id={section.id}><div><span class="section-number">0{index + 1}</span><p class="kicker">{section.kicker}</p><h2>{section.title}</h2></div><div class="detail-copy">{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}{section.link && <a class="text-link" href={section.link.href}>{section.link.text} <ArrowRight size={16}/></a>}</div></section>)}</div>
    <section class="shell scope-section" id="costs"><div class="section-heading"><div><p class="kicker">Know what you are agreeing to</p><h2 class="title">The quote &amp;<br/>the details.</h2></div><p class="lede">{rental ? 'Ask for a quote for the whole agreed rental period, with any separate costs identified. Review the vehicle, requirements, and terms together before payment.' : 'Ask for a quote for your agreed route and group. A useful breakdown separates the journey, the visits, and any optional activities.'}</p></div><dl class="scope-list">{content.scope.map(row => <div><dt>{row.title}</dt><dd>{row.text}</dd></div>)}</dl></section>
    <section class="section shell booking-section" id="booking"><div class="section-heading"><div><p class="kicker">From the first message</p><h2 class="title">{rental ? 'Arrange your rental.' : 'Plan your tour with Ayu.'}</h2></div><p class="lede">Start with your dates and needs. The steps below help you agree on the actual service, price, and terms for your booking.</p></div><ol class="booking-steps">{content.steps.map((step, index) => <li><span class="step-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></section>
    <section class="quote-band" id="quote"><div class="shell quote-grid"><div><p class="kicker">One message to get started</p><h2 class="title">{rental ? 'Tell us about your stay.' : 'Tell us about your day.'}</h2><p class="lede">{rental ? 'Share your rental dates and preferred vehicle type. Ayu will help check the available arrangement for your location and intended use.' : 'Send the places you would like to visit, or ask for help choosing. Ayu can discuss a route around your group, pickup point, and time available.'}</p><a class="button" href={quote}>{rental ? 'Request a rental quote' : 'Request a tour quote'} <ArrowUpRight size={16}/></a></div><div class="checklist"><h3>Include in your enquiry</h3><ul>{content.enquiryItems.map(item => <li><Check size={17}/><span>{item}</span></li>)}</ul></div></div></section>
    <section class="section shell questions" id="questions"><div><p class="kicker">Before you commit</p><h2 class="title">Good to know.</h2></div><div>{content.faqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>
    <section class="shell contact-card"><img src="/images/buk-ayu.jpeg" alt="Bu Ayu, owner of Utami Mesari Tours" width="908" height="1600" loading="lazy"/><div><p class="kicker">Your local contact</p><h2>Plan with Bu Ayu.</h2><p>Talk with the owner of Utami Mesari Tours about your plans in Indonesian or English. Ayu also helps with hotel and villa recommendations and local itineraries.</p><a class="text-link" href={quote}><MessageCircle size={16}/> +62 819-9996-6044 <ArrowUpRight size={15}/></a></div><div class="contact-facts"><a class="text-link" href="/#about">Meet Bu Ayu <ArrowRight size={15}/></a><br/><a class="text-link" href="https://www.instagram.com/infowisata_bali/">Instagram @infowisata_bali <ArrowUpRight size={15}/></a></div></section>
    <section class="section shell service-related"><p class="kicker">Keep planning</p><h2>More for your Lovina stay.</h2><div>{content.related.map(link => <a href={link.href}><h3>{link.text} <ArrowRight size={16}/></h3><p>{link.detail}</p></a>)}</div></section>
    <p class="shell updated">Last updated <time datetime={updated}>3 November 2026</time> · Service enquiries: Bu Ayu, Utami Mesari Tours</p>
  </main>
  <SiteFooter />
</BaseLayout>
