---
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from './BaseLayout.astro';
import '../styles/transport-layout.css';
import { ArrowRight, ArrowUpRight, Check, MapPin, Users, MessageCircle } from 'lucide-astro';
import { transportPages, transportDetails, transportQuote, type TransportPageKey } from '../data/transport';
interface Props { page: TransportPageKey }
const { page } = Astro.props;
const content = transportPages[page];
const extra = transportDetails[page];
const updated = '2026-11-03';
const quoteUrl = transportQuote(content.label.toLowerCase());
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: content.title, description: content.description, url: new URL(content.path, Astro.site).href, inLanguage: 'en', dateModified: updated, mainEntity: { '@type': 'Service', name: content.label, serviceType: content.label, provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: ['Lovina', 'Singaraja', 'Negara', 'Denpasar'] } };
const breadcrumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href }, ...(page !== 'hub' ? [{ '@type': 'ListItem', position: 2, name: 'Transport', item: new URL('/transportasi/', Astro.site).href }] : []), { '@type': 'ListItem', position: page === 'hub' ? 2 : 3, name: content.label, item: new URL(content.path, Astro.site).href }] };
---
<BaseLayout title={content.title} description={content.description} image={content.image} imageAlt={content.imageAlt}>
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} /><script type="application/ld+json" set:html={JSON.stringify(breadcrumbs).replace(/</g, '\u003c')} /></Fragment>
  <header class="road-header"><div class="shell road-nav"><a class="brand" href="/"><span class="brand-mark">U</span><span>Utami Mesari Tours<small>Lovina · North Bali</small></span></a><nav aria-label="Transport navigation"><a href="/transportasi/" aria-current={page === 'hub' ? 'page' : undefined}>Transport</a><a href="/transportasi/sewa-mobil-singaraja/" aria-current={page === 'car' ? 'page' : undefined}>Private cars</a><a href="/transportasi/rombongan/" aria-current={page === 'group' ? 'page' : undefined}>Groups</a></nav><a class="button header-cta" href={quoteUrl}>Ask Bu Ayu <ArrowUpRight size={16}/></a></div></header>
  <main id="top">
    <section class="shell road-hero"><div class="hero-copy"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span>{page !== 'hub' && <><a href="/transportasi/">Transport</a><span>/</span></>}<span>{page === 'hub' ? 'Transport' : page === 'car' ? 'Private cars' : 'Groups'}</span></nav><p class="kicker">{content.kicker}</p><h1>{content.heading}</h1><p class="hero-intro">{content.intro}</p><a class="button" href="#options">{page === 'group' ? 'Compare the vehicles' : 'Explore your options'} <ArrowRight size={16}/></a><p class="hero-meta">Local contact · Indonesian &amp; English</p></div><figure class="hero-image"><img src={content.image} alt={content.imageAlt} fetchpriority="high"/><figcaption>On the road · Utami Mesari Tours</figcaption></figure></section>
    <section class="answer-band"><div class="shell answer-inner"><p class="kicker">{content.label}</p><p>{content.answer}</p></div></section>
    <nav class="shell page-jumps" aria-label="On this page"><a href="#options">Vehicle options</a><a href="#journey-ideas">Journey ideas</a><a href="#costs">Prices &amp; inclusions</a><a href="#booking">How to book</a><a href="#questions">Questions</a></nav>
    <section class="section shell" id="options"><div class="section-heading"><div><p class="kicker">The right fit for your trip</p><h2 class="title">{content.sectionTitle}</h2></div><p class="lede">{content.sectionIntro}</p></div><div class="vehicle-grid">{content.cards.map((card, index) => <article class="vehicle-card"><div class="card-image"><img src={card.image} alt="" loading="lazy"/><span>0{index + 1} / Your journey</span></div><div class="card-body"><p class="kicker">{card.label}</p><h3>{card.title}</h3><p>{card.text}</p><a class="text-link" href={card.href}>{card.anchor} <ArrowRight size={16}/></a></div></article>)}</div><p class="image-note">Gallery images illustrate our transport services. Confirm the exact vehicle and seating with your booking.</p></section>
    {page === 'hub' && <section class="shell trip-types" aria-labelledby="trip-types-title"><p class="kicker">Start with the kind of journey</p><h2 id="trip-types-title">What do you need transport for?</h2><div class="planning-grid"><article><h3>Getting from A to B</h3><p>Send your pickup and final destination for a transfer enquiry. For a return trip, add the return pickup time and location.</p></article><article><h3>A journey with visits</h3><p>List your proposed stops and the time you want at each. Ask Ayu to help plan the route and any driver or guide support.</p></article><article><h3>A longer stay</h3><p>Ask about long-term car or motorbike rental with your start and end dates, location, and preferred vehicle type.</p></article></div></section>}
    {page === 'car' && <section class="shell model-options" aria-labelledby="model-title"><p class="kicker">Have a model in mind?</p><h2 id="model-title">Tell Ayu your preference.</h2><p>These are the family-car options to ask about. Choose a model below to include it in your WhatsApp enquiry, or let Ayu suggest one for your passengers and bags.</p><div class="model-links">{['Terios', 'Avanza', 'Xpander', 'Xenia'].map((model) => <a class="button secondary" href={transportQuote(`${model} private car transport in Lovina or Singaraja`)}>{model} <ArrowUpRight size={15}/></a>)}<a class="button" href={transportQuote('help choosing a private car for my journey')}>Help me choose <ArrowRight size={15}/></a></div><p class="image-note">Model, seating, luggage capacity, and availability are confirmed for your date. A model preference is not a reservation.</p></section>}
    {page === 'group' && <section class="shell comparison" aria-labelledby="compare-title"><p class="kicker">Passenger capacity at a glance</p><h2 id="compare-title">Compare Hiace &amp; Elf</h2><div class="table-scroll"><table><caption>Passenger counts exclude the driver. Luggage space and the assigned vehicle need confirmation.</caption><thead><tr><th scope="col">Vehicle</th><th scope="col">Passengers</th><th scope="col">Driver</th><th scope="col">Before booking</th></tr></thead><tbody><tr><th scope="row">Hiace</th><td>Up to 15</td><td>1</td><td>Check seats and bags together</td></tr><tr><th scope="row">Elf</th><td>Up to 19</td><td>1</td><td>Check seats and bags together</td></tr></tbody></table></div><p class="capacity-advice">For 16–19 passengers, Hiace’s listed capacity will not fit the whole party in one vehicle; discuss Elf with Ayu. For 15 or fewer, check both seating and luggage needs. Above 19, ask what arrangement may be possible before making plans.</p></section>}
    <section class="section shell journey-ideas" id="journey-ideas"><div class="section-heading"><div><p class="kicker">Places &amp; plans to discuss</p><h2 class="title">{extra.routeHeading}</h2></div><p class="lede">{extra.routeIntro}</p></div><div class="journey-grid">{extra.routes.map((route) => <article><h3>{route.tourHref ? <a href={route.tourHref}>{route.title}</a> : route.title}</h3><p class="places">{route.places}</p><p>{route.planning}</p><a class="text-link" href={transportQuote(`${route.title.toLowerCase()} — ${route.places}`)}>Discuss this journey <ArrowUpRight size={15}/></a></article>)}</div><p class="image-note">Journey ideas are not fixed packages or a promise to include every stop. Ask for the final itinerary and any separate activity costs. For visit planning, explore <a href="/tur-bali-utara/">North Bali tour options</a>. For help leaving room in your schedule, read <a href="/blog/a-slow-day-in-north-bali">our slower North Bali day-planning ideas</a>.</p></section>
    <div class="shell details-sections">{content.sections.map((section, index) => <section class="detail-section" id={section.id}><div><span class="section-number">0{index + 1}</span><p class="kicker">{section.kicker}</p><h2>{section.title}</h2></div><div class="detail-copy">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{'link' in section && section.link && <a class="text-link" href={section.link.href}>{section.link.text} <ArrowRight size={16}/></a>}{((page === 'hub' && section.id === 'travel-plans') || (page === 'car' && section.id === 'driver')) && <p>Need a vehicle for a longer stay? See <a class="text-link" href="/sewa-kendaraan-jangka-panjang/">long-term car and motorbike rental enquiries</a>.</p>}</div></section>)}</div>
    <section class="shell scope-section" id="costs"><div class="section-heading"><div><p class="kicker">Understand your quote</p><h2 class="title">The price &amp;<br/>what it covers.</h2></div><p class="lede">Request a price for your actual journey. The route, date, vehicle, and time needed help define the quote. Use this breakdown to agree on the service and any separate costs.</p></div><dl class="scope-list">{extra.scope.map((row) => <div><dt>{row.item}</dt><dd>{row.detail}</dd></div>)}</dl></section>
    <section class="section shell booking-section" id="booking"><div class="section-heading"><div><p class="kicker">From the first message to pickup</p><h2 class="title">How to arrange<br/>your transport.</h2></div><p class="lede">{extra.bookingIntro}</p></div><ol class="booking-steps">{extra.booking.map((step, index) => <li><span class="step-number">0{index + 1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></section>
    <section class="quote-band" id="quote"><div class="shell quote-grid"><div><p class="kicker">Your route, clearly agreed</p><h2 class="title">Let’s plan<br/>your journey.</h2><p class="lede">Send Bu Ayu the details below for availability and a quote. If part of your itinerary is undecided, say what you would like help planning.</p><a class="button" href={quoteUrl}>Request a transport quote <ArrowUpRight size={16}/></a></div><div class="checklist"><h3>Your enquiry checklist</h3><ul>{content.checklist.map((item) => <li><Check size={17}/><span>{item}</span></li>)}</ul></div></div></section>
    <section class="section shell questions" id="questions"><div><p class="kicker">Before you book</p><h2 class="title">Good to know.</h2></div><div>{[...content.faqs, ...extra.faqs].map((faq) => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>
    <section class="shell contact-card"><img src="/images/buk-ayu.jpeg" alt="Bu Ayu, owner of Utami Mesari Tours" loading="lazy" width="908" height="1600"/><div><p class="kicker">Your local contact</p><h2>Talk with Bu Ayu.</h2><p>Owner of Utami Mesari Tours. Ask about transport and travel plans in Indonesian or English.</p>{page === 'hub' && <p>Through her insurance work, Ayu built relationships with hotels, villas, and local tourism operators. Today she helps travellers discuss transport, stays, and itineraries around Lovina.</p>}<a class="text-link" href={quoteUrl}><MessageCircle size={16}/> +62 819-9996-6044 <ArrowUpRight size={15}/></a></div><div class="contact-facts"><p><MapPin size={17}/> Lovina · North Bali</p><p><Users size={17}/> Private &amp; group transport</p><a class="text-link" href="/#about">Get to know Ayu <ArrowRight size={15}/></a><br/><a class="text-link" href="https://www.instagram.com/infowisata_bali/" rel="noreferrer">Instagram @infowisata_bali <ArrowUpRight size={15}/></a></div></section>
    <nav class="shell related" aria-label="Related services">{page !== 'hub' && <a href="/transportasi/">All transport <ArrowRight size={16}/></a>}{page !== 'car' && <a href="/transportasi/sewa-mobil-singaraja/">Private cars <ArrowRight size={16}/></a>}{page !== 'group' && <a href="/transportasi/rombongan/">Hiace &amp; Elf groups <ArrowRight size={16}/></a>}<a href="/dolphin-tour-lovina/">Dolphin tour Lovina <ArrowRight size={16}/></a><a href={page === 'group' ? '/gallery#group-transport' : '/gallery#family-transport'}>Transport gallery <ArrowRight size={16}/></a></nav>
    <p class="shell guide-connection">{page === 'group' ? <Fragment>Planning a group boat outing too? <a href="/blog/sharing-or-private-boat">Compare private and sharing dolphin boats</a> before choosing the boat arrangement.</Fragment> : <Fragment>Travelling to an early boat departure? Use the <a href="/blog/best-time-to-see-dolphins-in-lovina#pickup">dolphin tour pickup preparation checklist</a> alongside your agreed transport details.</Fragment>}</p>
    <p class="shell updated">Last updated <time datetime={updated}>3 November 2026</time> · Service enquiries: Bu Ayu, Utami Mesari Tours</p>
  </main>
  <SiteFooter />
</BaseLayout>
